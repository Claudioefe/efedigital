---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildGraph,
  organizationSchema,
  buildBreadcrumbSchema,
  buildFaqPageSchema,
  buildServiceSchema,
} from "../../data/schema";
import { homeServicios } from "../../data/home-servicios";
import { SERVICIOS_INDEXABLES } from "../../data/site-config";

const title = "Optimización de Velocidad y Core Web Vitals | efedigital";
const description =
  "Detectamos qué frena tu sitio y lo corregimos: caché a medida, código innecesario y ajustes de servidor, medido con Core Web Vitals. Desde USD 300.";

const breadcrumb = buildBreadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Servicios", path: "/servicios" },
  { name: "Optimización", path: "/servicios/optimizacion" },
]);

const optiFaqs = [
  {
    pregunta: "¿Cuánto sale una optimización?",
    respuesta:
      "Depende de qué encontremos en el diagnóstico inicial: un sitio con poco código innecesario y buena caché sale menos que uno que nunca se tocó desde que se armó. Como referencia, arranca en USD 300. Te confirmamos precio cerrado después de que nos cuentes tu caso, por mail, WhatsApp o una llamada.",
  },
  {
    pregunta: "¿Cuánto tarda?",
    respuesta:
      "Entre una y dos semanas, según el tamaño del sitio y cuántos ajustes haga falta hacer. El diagnóstico inicial ya te da una idea del alcance antes de arrancar con los cambios.",
  },
  {
    pregunta: "¿Qué pasa si después de optimizar el sitio se vuelve a poner lento?",
    respuesta:
      'Es lo más común, y no es que la optimización "no sirvió": es que se instaló un plugin nuevo, se subieron imágenes pesadas sin comprimir, o WordPress se actualizó y algo cambió. Para eso existe el mantenimiento mensual, que revisa esto de forma continua en vez de dejar que se acumule.',
  },
  {
    pregunta: "¿Esto reemplaza al mantenimiento mensual?",
    respuesta:
      "No, son complementarios. La optimización es el arreglo puntual de velocidad; el mantenimiento es lo que evita que ese trabajo se pierda con el tiempo. Muchos clientes arrancan con la optimización y después suman el plan mensual para sostenerla.",
  },
  {
    pregunta: "¿Necesito hacer primero la auditoría técnica de SEO/GEO/AEO, o esto alcanza?",
    respuesta:
      "No hace falta la auditoría completa si lo que te preocupa puntualmente es la velocidad. La auditoría mira más cosas (datos estructurados, indexación, legibilidad para IA); la optimización se enfoca solo en rendimiento. Si no estás seguro de cuál necesitás, contanos tu caso y te decimos cuál conviene.",
  },
];

const servicio = homeServicios[2];
const schema = buildGraph(
  organizationSchema,
  breadcrumb,
  buildServiceSchema(servicio),
  buildFaqPageSchema(optiFaqs, "/servicios/optimizacion")
);

const revisamos = [
  {
    num: "01",
    badge: "DIAG",
    titulo: "Diagnóstico de velocidad",
    desc: "Partimos de tu informe de auditoría técnica si ya lo tenés, o medimos el estado actual con datos de campo y de laboratorio para saber exactamente qué está pesando: imágenes, scripts, plugins o el servidor.",
    nota: "Es el punto de partida para corregir, no otro informe: de acá en más ya vamos directo al arreglo.",
  },
  {
    num: "02",
    badge: "CACHE",
    titulo: "Caché a medida",
    desc: "Configuramos una estrategia de caché ajustada a tu sitio, no un plugin genérico con configuración por defecto, para que las páginas se sirvan rápido sin romper el contenido dinámico (carritos, formularios).",
    nota: "Un plugin de caché mal configurado puede mostrar información vieja; por eso se ajusta a medida.",
  },
  {
    num: "03",
    badge: "CODE",
    titulo: "Limpieza de código innecesario",
    desc: "Sacamos scripts, estilos y plugins que cargan en todas las páginas aunque solo se usen en una, o que quedaron de una versión anterior del sitio y nadie los usa.",
    nota: "Menos código para descargar es, casi siempre, la mejora con más impacto y menos riesgo.",
  },
  {
    num: "04",
    badge: "IMG",
    titulo: "Optimización de imágenes y recursos",
    desc: "Compresión, formatos modernos y carga diferida (lazy loading) para que las imágenes no sean lo que más tarda en cargar la página.",
    nota: "En la mayoría de los sitios, las imágenes son la primera causa de lentitud.",
  },
  {
    num: "05",
    badge: "CDN",
    titulo: "Ajustes de servidor y Cloudflare",
    desc: "Configuración de CDN, compresión y cabeceras de caché a nivel de servidor, no solo del lado del sitio.",
    nota: "Algunas mejoras no se ven en el código del sitio, se ven en cómo el servidor entrega ese código.",
  },
];

const entrega = [
  {
    num: "01",
    titulo: "Medición inicial",
    desc: "Sacamos una foto del estado actual con PageSpeed Insights y datos reales de usuarios, para tener un punto de partida documentado antes de tocar nada.",
    nota: "Sin esta foto inicial, no hay forma de demostrar después que mejoró.",
  },
  {
    num: "02",
    titulo: "Optimización aplicada y medida",
    desc: "Aplicamos los cambios y volvemos a medir con las mismas herramientas, para mostrar la diferencia real, no una promesa.",
    nota: "Se mide en el mismo entorno y condiciones que la medición inicial, para que la comparación sea justa.",
  },
  {
    num: "03",
    titulo: "Informe antes/después",
    desc: "Te dejamos un informe con las métricas de antes y después, y una recomendación sobre si conviene sumar mantenimiento mensual para sostener el resultado.",
    nota: "El informe es tuyo, elijas o no seguir con mantenimiento.",
  },
];

const herramientas = ["PageSpeed", "Core Web Vitals", "Caché", "Cloudflare", "Código innecesario"];
---

<BaseLayout
  title={title}
  description={description}
  path="/servicios/optimizacion"
  schema={schema}
  noindex={!SERVICIOS_INDEXABLES}>
  <div id="efe-thread-opt" aria-hidden="true" style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:0;pointer-events:none"></div>

  <section id="top" class="efe-section efe-section--tight" style="position:relative">
    <div class="efe-container">
      <div
        style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-bottom:22px;border-bottom:1px solid rgba(255,255,255,.1)"
      >
        <div class="efe-eyebrow" style="margin-bottom:0">Servicio — Optimización web</div>
        <div
          style="display:flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8B8B93"
        >
          <a href="/" class="efe-crumb-link">Inicio</a>
          <span>/</span>
          <a href="/servicios/" class="efe-crumb-link">Servicios</a>
          <span>/</span>
          <span style="color:#F5F2EC">Optimización</span>
        </div>
      </div>

      <div class="efe-svc-hero-grid" style="margin-top:clamp(48px,6vw,80px)">
        <div>
          <h1 class="efe-h1" data-reveal>
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.05s">Optimización</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.15s">de velocidad y</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em">
              <span class="efe-word" style="animation-delay:.25s"
                >Core Web Vitals</span
              >
            </span>
          </h1>

          <p class="efe-lede" data-reveal data-delay="1" style="margin-top:clamp(24px,3vw,34px);max-width:52ch">
            Detectamos qué está frenando tu sitio y lo corregimos: <span style="color:#EDEDF0"
              >caché a medida, limpieza de código innecesario y ajustes de servidor</span
            >, medidos con las métricas que Google usa para evaluar velocidad.
          </p>

          <div data-reveal data-delay="2" style="display:flex;flex-wrap:wrap;gap:18px;margin-top:clamp(28px,3.4vw,40px)">
            <a href="/contacto/" class="efe-btn efe-btn--primary">Medir mi sitio <span style="font-size:14px">↗</span></a>
            <a href="#revisamos" class="efe-btn efe-btn--ghost">Qué revisamos</a>
          </div>

          <ul data-reveal data-delay="3" style="display:flex;flex-wrap:wrap;gap:10px;margin:28px 0 0;padding:0;list-style:none">
            {herramientas.map((h) => (
              <li class="efe-tag">{h}</li>
            ))}
          </ul>
        </div>

        <div data-reveal data-delay="1" class="efe-svc-panel">
          <div class="efe-svc-panel__head">
            <span class="efe-svc-panel__dot"></span> Qué revisamos
            <span class="efe-svc-panel__badge">Vista previa</span>
          </div>
          {
            revisamos.slice(0, 3).map((row) => (
              <div class="efe-svc-panel__row">
                <p style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:18px;color:#F5F2EC">{row.titulo}</p>
                <p style="margin:8px 0 0;font-size:13.5px;line-height:1.55;color:#8B8B93">{row.desc}</p>
              </div>
            ))
          }
          <a href="#revisamos" class="efe-svc-panel__footer">
            Ver todo lo que revisamos <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="revisamos" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div class="efe-svc-intro-grid" style="grid-template-columns:minmax(0,3fr) minmax(0,2fr)">
        <div data-reveal>
          <div class="efe-eyebrow">01 — Qué revisamos</div>
          <h2 class="efe-h2">¿Qué hacemos <br />en una <br />optimización?</h2>
        </div>
        <p class="efe-lede" data-reveal data-delay="1" style="max-width:52ch">
          Acá el foco es un solo número: cuánto tarda tu sitio en cargar y responder, medido con Core Web Vitals
          (LCP, INP, CLS), las métricas que Google usa para evaluar la experiencia de carga.
        </p>
      </div>

      <div class="efe-svc-grid" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          revisamos.map((item) => (
            <div data-scroll="tilt" class="efe-svc-card">
              <div class="efe-svc-card__top">
                <span class="efe-svc-card__num">{item.num}</span>
                <span class="efe-svc-card__badge">{item.badge}</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-svc-card__desc">{item.desc}</p>
              <div class="efe-svc-card__foot">{item.nota}</div>
            </div>
          ))
        }
        <a href="/contacto/" class="efe-svc-cta">
          <div class="efe-svc-cta__eyebrow">Empecemos por tu sitio</div>
          <h3 class="efe-h3" style="color:#08080A">¿Querés medir <br />tu velocidad?</h3>
          <span class="efe-svc-cta__btn">Medir mi sitio <span>↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section id="entrega" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div data-reveal>
        <div class="efe-eyebrow">03 — Entrega</div>
        <h2 class="efe-h2">Cómo se <br />entrega</h2>
      </div>

      <div class="efe-grid efe-grid--3" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          entrega.map((item) => (
            <div data-scroll="tilt" class="efe-svc-card">
              <div class="efe-svc-card__top">
                <span class="efe-svc-card__num">{item.num}</span>
                <span class="efe-svc-card__badge">↗</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-svc-card__desc">{item.desc}</p>
              <div class="efe-svc-card__foot">{item.nota}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="preguntas" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(32px,5vw,80px);align-items:start">
      <div data-reveal>
        <div class="efe-eyebrow">04 — Preguntas</div>
        <h2 style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:clamp(34px,5.4vw,82px);line-height:.9;letter-spacing:-.042em">
          Lo que nos <br />preguntan
        </h2>
        <p style="margin:26px 0 0;max-width:32ch;font-size:16.5px;line-height:1.6;color:#8B8B93;text-wrap:pretty">
          Si te queda alguna duda, escribinos: contestamos nosotros, no un bot.
        </p>
      </div>
      <div data-reveal data-delay="1" style="display:flex;flex-direction:column;border-top:1px solid rgba(255,255,255,.12)">
        {
          optiFaqs.map((f, i) => (
            <div class="efe-faq-item" style="border-bottom:1px solid rgba(255,255,255,.12)">
              <button type="button" class="efe-faq-toggle" aria-expanded="false" data-index={i}>
                <span class="efe-faq-question">{f.pregunta}</span>
                <span class="efe-faq-icon">+</span>
              </button>
              <div class="efe-faq-panel">
                <p style="margin:0;padding:0 0 26px;min-height:0;overflow:hidden;max-width:58ch;font-size:15.5px;line-height:1.66;color:#8B8B93;text-wrap:pretty">
                  {f.respuesta}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .efe-word {
    display: inline-block;
    animation: efe-rise 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .efe-svc-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(300px, 5fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .efe-svc-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-tag {
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a9a9b1;
  }

  .efe-svc-panel {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0d0d10;
  }
  .efe-svc-panel__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b8b93;
  }
  .efe-svc-panel__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4ff3f;
    animation: efe-pulse 2.2s ease-in-out infinite;
  }
  .efe-svc-panel__badge {
    margin-left: auto;
    color: #f5f2ec;
  }
  .efe-svc-panel__row {
    padding: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .efe-svc-panel__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 22px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f5f2ec;
    transition: color 0.22s ease;
  }
  .efe-svc-panel__footer:hover {
    color: #d4ff3f;
  }

  .efe-svc-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }
  @media (max-width: 760px) {
    .efe-svc-intro-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 1.8vw, 24px);
  }
  @media (min-width: 720px) {
    .efe-svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .efe-svc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .efe-svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.45s ease, background 0.45s ease, box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-svc-card:hover {
    border-color: #d4ff3f;
    background: #121218;
    box-shadow: 10px 10px 0 rgba(212, 255, 63, 0.85);
    translate: -5px -5px;
  }
  .efe-svc-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .efe-svc-card__num {
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
    color: rgba(245, 242, 236, 0.12);
  }
  .efe-svc-card__badge {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 26px;
    padding: 0 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: #8b8b93;
  }
  .efe-svc-card h3 {
    margin-top: 14px;
  }
  .efe-svc-card__desc {
    margin: 12px 0 0;
    padding-bottom: 10px;
    font-size: 14.5px;
    line-height: 1.58;
    color: #c9c9ce;
  }
  .efe-svc-card__foot {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    line-height: 1.5;
    color: #96969b;
  }

  .efe-svc-cta {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #d4ff3f;
    text-decoration: none;
    transition: transform 0.18s ease;
  }
  .efe-svc-cta:hover {
    transform: translate(-3px, -3px);
  }
  .efe-svc-cta__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #08080a;
  }
  .efe-svc-cta__eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: #08080a;
  }
  .efe-svc-cta h3 {
    margin-top: 16px;
    font-size: clamp(24px, 3vw, 44px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .efe-svc-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(20px, 2.4vw, 30px);
    padding: 15px 22px;
    background: #08080a;
    color: #f5f2ec;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: flex-start;
  }

  /* Acordeón de preguntas — mismo comportamiento que Faq.astro (componente no
     importado en esta página: cada instancia necesita su propia copia). */
  .efe-faq-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding: 24px 0;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: #f5f2ec;
    font-size: clamp(16px, 1.5vw, 19.5px);
    font-weight: 600;
    line-height: 1.34;
    font-family: var(--font-body);
  }
  .efe-faq-question {
    position: relative;
  }
  .efe-faq-question::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: #d4ff3f;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-faq-toggle:hover .efe-faq-question::after {
    transform: scaleX(1);
  }
  .efe-faq-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #8b8b93;
    font-size: 16px;
    line-height: 1;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease, border-color 0.3s ease;
  }
  .efe-faq-toggle:hover .efe-faq-icon {
    border-color: #d4ff3f;
    color: #d4ff3f;
  }
  .efe-faq-panel {
    display: grid;
    grid-template-rows: minmax(0, 0fr);
    min-height: 0;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
    transition: grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.42s;
  }
  .efe-faq-panel > p {
    min-height: 0;
  }
  .efe-faq-item.is-open .efe-faq-icon {
    transform: rotate(135deg);
    color: #d4ff3f;
    border-color: #d4ff3f;
  }
  .efe-faq-item.is-open .efe-faq-panel {
    grid-template-rows: minmax(0, 1fr);
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".efe-faq-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".efe-faq-item");
      if (!item) return;
      const willOpen = !item.classList.contains("is-open");
      item.parentElement?.querySelectorAll(".efe-faq-item.is-open").forEach((open) => {
        open.classList.remove("is-open");
        open.querySelector(".efe-faq-toggle")?.setAttribute("aria-expanded", "false");
      });
      if (willOpen) {
        item.classList.add("is-open");
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
