---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildGraph,
  organizationSchema,
  buildBreadcrumbSchema,
  buildFaqPageSchema,
  buildServiceSchema,
} from "../../data/schema";
import { homeServicios } from "../../data/home-servicios";
import { SERVICIOS_INDEXABLES } from "../../data/site-config";

const title = "Auditoría Técnica de SEO, GEO & AEO | efedigital";
const description =
  "Revisamos si tu sitio es rápido, rastreable e indexable, y si los motores de IA pueden leerlo y citarlo. Informe priorizado por impacto. Desde USD 100.";

const breadcrumb = buildBreadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Servicios", path: "/servicios" },
  { name: "Auditoría técnica de SEO, GEO y AEO", path: "/servicios/auditoria-tecnica" },
]);

const auditFaqs = [
  {
    pregunta: "¿Cuánto sale la auditoría?",
    respuesta:
      "Arranca en USD 100. Varía según el tamaño del sitio y cuántas páginas hay que revisar, pero te lo confirmamos apenas nos cuentes tu caso —por mail, WhatsApp o una llamada— antes de arrancar.",
  },
  {
    pregunta: "¿Cuánto tarda una auditoría?",
    respuesta: "Entre 24 y 72 horas desde que arrancamos, dependiendo del tamaño del sitio.",
  },
  {
    pregunta: "¿Sirve para cualquier tipo de sitio, no solo WordPress?",
    respuesta:
      "Sí. La auditoría es sobre SEO técnico, GEO y AEO: son principios que aplican a cualquier sitio, esté hecho en WordPress, Shopify, algo a medida o cualquier otro stack. Lo único que cambia es cómo se implementan después las correcciones.",
  },
  {
    pregunta: "¿Qué pasa si encuentran algo urgente?",
    respuesta:
      "No esperamos a entregarte el informe completo: si encontramos algo que te está haciendo perder plata o visibilidad ahora mismo (una desindexación, un error de servidor, algo caído), te avisamos apenas lo vemos.",
  },
  {
    pregunta: "¿Esto reemplaza al SEO de contenido?",
    respuesta:
      "No. Esta auditoría es solo diagnóstico: revisamos datos estructurados, indexación, arquitectura y rendimiento, y te entregamos los hallazgos priorizados. Implementar las correcciones es otra cosa, que podés hacer vos, sumar a un plan de mantenimiento, o cotizar aparte con nosotros. Si el problema es de contenido o estrategia, te lo marcamos en el informe para tu equipo.",
  },
  {
    pregunta: "¿Es lo mismo que la optimización de velocidad o que el mantenimiento mensual?",
    respuesta:
      "No, son tres cosas distintas y complementarias. La auditoría diagnostica todo (datos estructurados, indexación, arquitectura, velocidad y legibilidad para IA) y te entrega un informe, sin tocar nada. La optimización de velocidad corrige puntualmente lo que encontramos en la parte de rendimiento. El mantenimiento mensual es lo que sostiene todo eso en el tiempo: actualizaciones, backups y seguridad, mes a mes.",
  },
];

const servicio = homeServicios[3];
const schema = buildGraph(
  organizationSchema,
  breadcrumb,
  buildServiceSchema(servicio),
  buildFaqPageSchema(auditFaqs, "/servicios/auditoria-tecnica")
);

const alcance = [
  {
    num: "01",
    badge: "SD",
    titulo: "Datos estructurados",
    desc: "Revisamos el marcado Schema.org de todo el sitio: qué entidades declarás, qué falta y qué está mal armado para que los buscadores entiendan de qué habla cada página.",
    nota: "Organization, Product, Article, FAQ, Breadcrumb y LocalBusiness según el caso.",
  },
  {
    num: "02",
    badge: "IX",
    titulo: "Indexación y rastreo",
    desc: "Search Console, robots.txt, sitemaps, canónicas y redirecciones. Buscamos páginas que Google no puede ver, páginas que ve de más, y páginas que ya posicionan bien pero nadie les hace clic.",
    nota: "Cobertura, errores de rastreo, contenido duplicado, presupuesto de rastreo y oportunidades de CTR.",
  },
  {
    num: "03",
    badge: "AR",
    titulo: "Arquitectura del sitio",
    desc: "Cómo están organizadas las URLs, el enlazado interno y la jerarquía de contenidos. Si la estructura no se entiende, el resto rinde menos.",
    nota: "Profundidad de clics, silos temáticos y páginas huérfanas.",
  },
  {
    num: "04",
    badge: "CWV",
    titulo: "Rendimiento y Core Web Vitals",
    desc: "Medimos LCP, INP y CLS en datos de campo y de laboratorio, e identificamos qué lo está frenando: recursos, plugins, imágenes o servidor.",
    nota: "Con el detalle de qué cambiar y cuánto se gana en cada punto.",
  },
  {
    num: "05",
    badge: "AEO",
    titulo: "Legibilidad para motores de IA",
    desc: "Si ChatGPT, Gemini, Claude o Perplexity pueden leer, entender y citar tus páginas: acceso de sus rastreadores, contenido renderizado y respuestas extraíbles.",
    nota: "llms.txt, acceso de bots de IA, contenido en HTML vs. JavaScript.",
  },
];

const entrega = [
  {
    num: "01",
    titulo: "Informe con hallazgos",
    desc: "Un documento con todo lo que encontramos, explicado en castellano: qué pasa, dónde pasa, por qué importa y qué hay que hacer.",
    nota: "Con capturas, URLs afectadas y la medición que respalda cada hallazgo.",
  },
  {
    num: "02",
    titulo: "Priorización por impacto",
    desc: "Los hallazgos ordenados por impacto real y esfuerzo de implementación, para que tu equipo sepa por dónde empezar el lunes.",
    nota: "Crítico, importante y deseable. Sin listas de 200 items iguales.",
  },
  {
    num: "03",
    titulo: "Opción de implementarlo",
    desc: "Si preferís que lo hagamos nosotros, te confirmamos un precio cerrado aparte por las mejoras técnicas, por etapa.",
    nota: "La auditoría no te obliga a nada: el informe es tuyo igual.",
  },
];

const informe = [
  {
    titulo: "SEO",
    tag: "Rastreable",
    desc: "Indexación, arquitectura y rendimiento: que Google pueda entrar, leer y entender cada página.",
    fill: 90,
  },
  {
    titulo: "GEO",
    tag: "Citable",
    desc: "Datos estructurados y entidades para que tu marca aparezca en respuestas generadas por IA.",
    fill: 84,
  },
  {
    titulo: "AEO",
    tag: "Extraíble",
    desc: "Contenido en HTML, acceso de bots de IA y respuestas que ChatGPT o Perplexity puedan citar.",
    fill: 72,
  },
];

const motores = ["Google", "ChatGPT", "Gemini", "Claude", "Perplexity"];
---

<BaseLayout
  title={title}
  description={description}
  path="/servicios/auditoria-tecnica"
  schema={schema}
  noindex={!SERVICIOS_INDEXABLES}>
  <div id="efe-thread-audit" aria-hidden="true" style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:0;pointer-events:none"></div>

  <section id="top" class="efe-section efe-section--tight" style="position:relative">
    <div class="efe-container">
      <div
        style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-bottom:22px;border-bottom:1px solid rgba(255,255,255,.1)"
      >
        <div class="efe-eyebrow" style="margin-bottom:0">Servicio — Auditoría técnica</div>
        <div
          style="display:flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8B8B93"
        >
          <a href="/" class="efe-crumb-link">Inicio</a>
          <span>/</span>
          <a href="/servicios/" class="efe-crumb-link">Servicios</a>
          <span>/</span>
          <span style="color:#F5F2EC">Auditoría técnica</span>
        </div>
      </div>

      <div class="efe-audit-hero-grid" style="margin-top:clamp(48px,6vw,80px)">
        <div>
          <h1 class="efe-h1" data-reveal>
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.05s">Auditoría</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.15s">técnica</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.25s">de SEO, GEO</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em">
              <span class="efe-word" style="animation-delay:.35s"
                >y AEO</span
              >
            </span>
          </h1>

          <p class="efe-lede" data-reveal data-delay="1" style="margin-top:clamp(24px,3vw,34px);max-width:52ch">
            Revisamos si tu sitio es <span style="color:#EDEDF0">rápido, rastreable e indexable</span>, y si los motores
            de IA pueden leerlo y citarlo. Te entregamos un informe con todo lo que encontramos, <span
              style="color:#EDEDF0">priorizado por impacto</span>.
          </p>

          <div data-reveal data-delay="2" style="display:flex;flex-wrap:wrap;gap:18px;margin-top:clamp(28px,3.4vw,40px)">
            <a href="/contacto/" class="efe-btn efe-btn--primary">Pedir la auditoría <span style="font-size:14px">↗</span></a>
            <a href="#alcance" class="efe-btn efe-btn--ghost">Qué revisamos</a>
          </div>

          <blockquote
            data-reveal
            data-delay="2"
            style="margin:clamp(28px,3.4vw,40px) 0 0;padding-left:18px;border-left:2px solid #D4FF3F;font-family:'JetBrains Mono',monospace;font-size:13px;line-height:1.65;color:#A9A9B1;max-width:52ch"
          >
            Somos la parte técnica. Si el problema es de contenido o estrategia, te lo marcamos en el informe
            para tu equipo, o te lo cotizamos aparte.
          </blockquote>

          <ul data-reveal data-delay="3" style="display:flex;flex-wrap:wrap;gap:10px;margin:28px 0 0;padding:0;list-style:none">
            {motores.map((m) => (
              <li class="efe-tag">{m}</li>
            ))}
          </ul>
        </div>

        <div data-reveal data-delay="1" class="efe-audit-panel">
          <div class="efe-audit-panel__head">
            <span class="efe-audit-panel__dot"></span> Informe de auditoría
            <span class="efe-audit-panel__badge">Vista previa</span>
          </div>
          {
            informe.map((row) => (
              <div class="efe-audit-panel__row">
                <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px">
                  <p style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:22px;color:#F5F2EC">{row.titulo}</p>
                  <span class="efe-audit-panel__tag">{row.tag}</span>
                </div>
                <p style="margin:8px 0 0;font-size:13.5px;line-height:1.55;color:#8B8B93">{row.desc}</p>
                <div class="efe-audit-panel__bar"><span style={`width:${row.fill}%`} /></div>
              </div>
            ))
          }
          <a href="#alcance" class="efe-audit-panel__footer">
            Hallazgos priorizados por impacto <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="alcance" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div class="efe-audit-intro-grid">
        <div data-reveal>
          <div class="efe-eyebrow">01 — Alcance de la revisión</div>
          <h2 class="efe-h2">¿Qué mira <br />esta auditoría?</h2>
        </div>
        <p class="efe-lede" data-reveal data-delay="1" style="max-width:52ch">
          Revisamos datos estructurados (Schema.org), indexación en Search Console, arquitectura del sitio,
          rendimiento y Core Web Vitals, y si el contenido es legible para los motores de IA que citan páginas web.
        </p>
      </div>

      <div class="efe-audit-grid" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          alcance.map((item) => (
            <div data-scroll="tilt" class="efe-audit-card">
              <div class="efe-audit-card__top">
                <span class="efe-audit-card__num">{item.num}</span>
                <span class="efe-audit-card__badge">{item.badge}</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-audit-card__desc">{item.desc}</p>
              <div class="efe-audit-card__foot">{item.nota}</div>
            </div>
          ))
        }
        <a href="/contacto/" class="efe-audit-cta">
          <div class="efe-audit-cta__eyebrow">Empecemos por el diagnóstico</div>
          <h3 class="efe-h3" style="color:#08080A">¿Necesitás una <br />auditoría?</h3>
          <span class="efe-audit-cta__btn">Pedir la auditoría <span>↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section id="entrega" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div data-reveal>
        <div class="efe-eyebrow">02 — Entrega</div>
        <h2 class="efe-h2">Cómo se <br />entrega</h2>
      </div>

      <div class="efe-grid efe-grid--3" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          entrega.map((item) => (
            <div data-scroll="tilt" class="efe-audit-card">
              <div class="efe-audit-card__top">
                <span class="efe-audit-card__num">{item.num}</span>
                <span class="efe-audit-card__badge">↗</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-audit-card__desc">{item.desc}</p>
              <div class="efe-audit-card__foot">{item.nota}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="preguntas" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(32px,5vw,80px);align-items:start">
      <div data-reveal>
        <div class="efe-eyebrow">03 — Preguntas</div>
        <h2 style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:clamp(34px,5.4vw,82px);line-height:.9;letter-spacing:-.042em">
          Lo que nos <br />preguntan
        </h2>
        <p style="margin:26px 0 0;max-width:32ch;font-size:16.5px;line-height:1.6;color:#8B8B93;text-wrap:pretty">
          Si te queda alguna duda, escribinos: contestamos nosotros, no un bot.
        </p>
      </div>
      <div data-reveal data-delay="1" style="display:flex;flex-direction:column;border-top:1px solid rgba(255,255,255,.12)">
        {
          auditFaqs.map((f, i) => (
            <div class="efe-faq-item" style="border-bottom:1px solid rgba(255,255,255,.12)">
              <button type="button" class="efe-faq-toggle" aria-expanded="false" data-index={i}>
                <span class="efe-faq-question">{f.pregunta}</span>
                <span class="efe-faq-icon">+</span>
              </button>
              <div class="efe-faq-panel">
                <p style="margin:0;padding:0 0 26px;min-height:0;overflow:hidden;max-width:58ch;font-size:15.5px;line-height:1.66;color:#8B8B93;text-wrap:pretty">
                  {f.respuesta}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .efe-word {
    display: inline-block;
    animation: efe-rise 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .efe-audit-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(300px, 5fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .efe-audit-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-tag {
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a9a9b1;
  }

  .efe-audit-panel {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0d0d10;
  }
  .efe-audit-panel__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b8b93;
  }
  .efe-audit-panel__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4ff3f;
    animation: efe-pulse 2.2s ease-in-out infinite;
  }
  .efe-audit-panel__badge {
    margin-left: auto;
    color: #f5f2ec;
  }
  .efe-audit-panel__row {
    padding: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .efe-audit-panel__tag {
    flex: none;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #d4ff3f;
  }
  .efe-audit-panel__bar {
    margin-top: 14px;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
  }
  .efe-audit-panel__bar span {
    display: block;
    height: 100%;
    background: #d4ff3f;
  }
  .efe-audit-panel__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 22px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f5f2ec;
    transition: color 0.22s ease;
  }
  .efe-audit-panel__footer:hover {
    color: #d4ff3f;
  }

  .efe-audit-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }
  @media (max-width: 760px) {
    .efe-audit-intro-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-audit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 1.8vw, 24px);
  }
  @media (min-width: 720px) {
    .efe-audit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .efe-audit-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .efe-audit-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.45s ease, background 0.45s ease, box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-audit-card:hover {
    border-color: #d4ff3f;
    background: #121218;
    box-shadow: 10px 10px 0 rgba(212, 255, 63, 0.85);
    translate: -5px -5px;
  }
  .efe-audit-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .efe-audit-card__num {
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
    color: rgba(245, 242, 236, 0.12);
  }
  .efe-audit-card__badge {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 26px;
    padding: 0 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: #8b8b93;
  }
  .efe-audit-card h3 {
    margin-top: 14px;
  }
  .efe-audit-card__desc {
    margin: 12px 0 0;
    padding-bottom: 10px;
    font-size: 14.5px;
    line-height: 1.58;
    color: #c9c9ce;
  }
  .efe-audit-card__foot {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    line-height: 1.5;
    color: #96969b;
  }

  .efe-audit-cta {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #d4ff3f;
    text-decoration: none;
    transition: transform 0.18s ease;
  }
  .efe-audit-cta:hover {
    transform: translate(-3px, -3px);
  }
  .efe-audit-cta__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #08080a;
  }
  .efe-audit-cta__eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: #08080a;
  }
  .efe-audit-cta h3 {
    margin-top: 16px;
    font-size: clamp(24px, 3vw, 44px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .efe-audit-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(20px, 2.4vw, 30px);
    padding: 15px 22px;
    background: #08080a;
    color: #f5f2ec;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: flex-start;
  }

  /* Acordeón de preguntas — mismo comportamiento que Faq.astro (componente no
     importado en esta página: cada instancia necesita su propia copia). */
  .efe-faq-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding: 24px 0;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: #f5f2ec;
    font-size: clamp(16px, 1.5vw, 19.5px);
    font-weight: 600;
    line-height: 1.34;
    font-family: var(--font-body);
  }
  .efe-faq-question {
    position: relative;
  }
  .efe-faq-question::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: #d4ff3f;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-faq-toggle:hover .efe-faq-question::after {
    transform: scaleX(1);
  }
  .efe-faq-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #8b8b93;
    font-size: 16px;
    line-height: 1;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease, border-color 0.3s ease;
  }
  .efe-faq-toggle:hover .efe-faq-icon {
    border-color: #d4ff3f;
    color: #d4ff3f;
  }
  .efe-faq-panel {
    display: grid;
    grid-template-rows: minmax(0, 0fr);
    min-height: 0;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
    transition: grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.42s;
  }
  .efe-faq-panel > p {
    min-height: 0;
  }
  .efe-faq-item.is-open .efe-faq-icon {
    transform: rotate(135deg);
    color: #d4ff3f;
    border-color: #d4ff3f;
  }
  .efe-faq-item.is-open .efe-faq-panel {
    grid-template-rows: minmax(0, 1fr);
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".efe-faq-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".efe-faq-item");
      if (!item) return;
      const willOpen = !item.classList.contains("is-open");
      item.parentElement?.querySelectorAll(".efe-faq-item.is-open").forEach((open) => {
        open.classList.remove("is-open");
        open.querySelector(".efe-faq-toggle")?.setAttribute("aria-expanded", "false");
      });
      if (willOpen) {
        item.classList.add("is-open");
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
