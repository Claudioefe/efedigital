---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { homeServicios } from "../../data/home-servicios";
import { SERVICIOS_HUB_INDEXABLE } from "../../data/site-config";
import { buildGraph, organizationSchema, buildBreadcrumbSchema, pageUrl } from "../../data/schema";

const title = "Servicios de desarrollo web y automatización | efedigital";
const description =
  "Desarrollo web y e-commerce, mantenimiento, optimización de velocidad, auditoría técnica de SEO, GEO y AEO, y automatización. Desde USD 100.";

const breadcrumb = buildBreadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Servicios", path: "/servicios" },
]);

const lista = {
  "@type": "CollectionPage",
  "@id": `${pageUrl("/servicios")}#page`,
  url: pageUrl("/servicios"),
  name: "Servicios de efedigital",
  description,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: homeServicios.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.titulo,
      url: pageUrl(s.href),
    })),
  },
};

const schema = buildGraph(organizationSchema, breadcrumb, lista);

const precio = (s: (typeof homeServicios)[number]) => `USD ${s.desde}${s.unidad === "mes" ? " / mes" : ""}`;
---

<BaseLayout title={title} description={description} path="/servicios" schema={schema} noindex={!SERVICIOS_HUB_INDEXABLE}>
  <section id="top" class="efe-section efe-section--tight" style="position:relative">
    <div class="efe-container">
      <div
        style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-bottom:22px;border-bottom:1px solid rgba(255,255,255,.1)"
      >
        <div class="efe-eyebrow" style="margin-bottom:0">Servicios</div>
        <div
          style="display:flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8B8B93"
        >
          <a href="/" class="efe-crumb-link">Inicio</a>
          <span>/</span>
          <span style="color:#F5F2EC">Servicios</span>
        </div>
      </div>

      <div class="efe-svc-hero-grid" style="margin-top:clamp(48px,6vw,80px)">
        <div>
          <h1 class="efe-h1" data-reveal>
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.05s">Servicios de</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.15s">desarrollo web</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.25s">y automatización</span></span
            >
          </h1>

          <p class="efe-lede" data-reveal data-delay="1" style="margin-top:clamp(24px,3vw,34px);max-width:52ch">
            Cinco servicios, un mismo equipo: del <span style="color:#EDEDF0">sitio o la tienda</span> a los sistemas
            que <span style="color:#EDEDF0">automatizan lo que hoy hacés a mano</span>. Cada uno con su precio de
            referencia y un alcance claro desde el principio.
          </p>

          <div data-reveal data-delay="2" style="display:flex;flex-wrap:wrap;gap:18px;margin-top:clamp(28px,3.4vw,40px)">
            <a href="/contacto/" class="efe-btn efe-btn--primary">Contanos tu caso <span style="font-size:14px">↗</span></a>
            <a href="#servicios-lista" class="efe-btn efe-btn--ghost">Ver los servicios</a>
          </div>
        </div>

        <div data-reveal data-delay="1" class="efe-svc-panel">
          <div class="efe-svc-panel__head">
            <span class="efe-svc-panel__dot"></span> Precios de referencia
            <span class="efe-svc-panel__badge">Desde</span>
          </div>
          {
            homeServicios.map((s) => (
              <a href={s.href} class="efe-svc-panel__row efe-svc-panel__row--link">
                <p style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:18px;color:#F5F2EC">{s.titulo}</p>
                <span class="efe-svc-panel__tag">{precio(s)}</span>
              </a>
            ))
          }
          <a href="/contacto/" class="efe-svc-panel__footer">
            El precio final depende del alcance <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="servicios-lista" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div class="efe-svc-intro-grid">
        <div data-reveal>
          <div class="efe-eyebrow">01 — Qué hacemos</div>
          <h2 class="efe-h2">En qué te <br />podemos ayudar</h2>
        </div>
        <p class="efe-lede" data-reveal data-delay="1" style="max-width:52ch">
          Elegí por dónde empezar. Si no sabés cuál necesitás, contanos tu caso y te decimos cuál conviene.
        </p>
      </div>

      <div class="efe-svc-grid" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          homeServicios.map((s) => (
            <a href={s.href} data-scroll="tilt" class="efe-svc-card">
              <div class="efe-svc-card__top">
                <span class="efe-svc-card__num">{s.num}</span>
                <span class="efe-svc-card__badge">↗</span>
              </div>
              <h3 class="efe-h3">{s.titulo}</h3>
              <p class="efe-svc-card__desc">{s.desc}</p>
              <div class="efe-svc-card__foot">Desde {precio(s)}</div>
            </a>
          ))
        }
        <a href="/contacto/" class="efe-svc-cta">
          <div class="efe-svc-cta__eyebrow">Empecemos por tu caso</div>
          <h3 class="efe-h3" style="color:#08080A">¿No sabés cuál <br />necesitás?</h3>
          <span class="efe-svc-cta__btn">Contanos tu caso <span>↗</span></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .efe-word {
    display: inline-block;
    animation: efe-rise 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .efe-svc-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(300px, 5fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .efe-svc-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-svc-panel {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0d0d10;
  }
  .efe-svc-panel__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b8b93;
  }
  .efe-svc-panel__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4ff3f;
    animation: efe-pulse 2.2s ease-in-out infinite;
  }
  .efe-svc-panel__badge {
    margin-left: auto;
    color: #f5f2ec;
  }
  .efe-svc-panel__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    transition: background 0.22s ease;
  }
  .efe-svc-panel__row--link:hover {
    background: #121218;
  }
  .efe-svc-panel__tag {
    flex: none;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #d4ff3f;
  }
  .efe-svc-panel__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 22px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f5f2ec;
    transition: color 0.22s ease;
  }
  .efe-svc-panel__footer:hover {
    color: #d4ff3f;
  }

  .efe-svc-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }
  @media (max-width: 760px) {
    .efe-svc-intro-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 1.8vw, 24px);
  }
  @media (min-width: 720px) {
    .efe-svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .efe-svc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .efe-svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #f5f2ec;
    text-decoration: none;
    transition: border-color 0.45s ease, background 0.45s ease, box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-svc-card:hover {
    color: #f5f2ec;
    border-color: #d4ff3f;
    background: #121218;
    box-shadow: 10px 10px 0 rgba(212, 255, 63, 0.85);
    translate: -5px -5px;
  }
  .efe-svc-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .efe-svc-card__num {
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
    color: rgba(245, 242, 236, 0.12);
  }
  .efe-svc-card__badge {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 26px;
    padding: 0 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: #8b8b93;
  }
  .efe-svc-card h3 {
    margin-top: 14px;
  }
  .efe-svc-card__desc {
    margin: 12px 0 0;
    padding-bottom: 10px;
    font-size: 14.5px;
    line-height: 1.58;
    color: #c9c9ce;
  }
  .efe-svc-card__foot {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    line-height: 1.5;
    color: #96969b;
  }

  .efe-svc-cta {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #d4ff3f;
    text-decoration: none;
    transition: transform 0.18s ease;
  }
  .efe-svc-cta:hover {
    transform: translate(-3px, -3px);
  }
  .efe-svc-cta__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #08080a;
  }
  .efe-svc-cta__eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: #08080a;
  }
  .efe-svc-cta h3 {
    margin-top: 16px;
    font-size: clamp(24px, 3vw, 44px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .efe-svc-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(20px, 2.4vw, 30px);
    padding: 15px 22px;
    background: #08080a;
    color: #f5f2ec;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: flex-start;
  }
</style>
