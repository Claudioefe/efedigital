---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildGraph,
  organizationSchema,
  buildBreadcrumbSchema,
  buildFaqPageSchema,
  buildServiceSchema,
} from "../../data/schema";
import { homeServicios } from "../../data/home-servicios";
import { SERVICIOS_INDEXABLES } from "../../data/site-config";

const title = "Desarrollo Web y E-commerce a Medida | efedigital";
const description =
  "Sitios y tiendas online a medida en WordPress, sin page builders: catálogo, checkout y pagos que funcionan en cualquier dispositivo. Desde USD 300.";

const breadcrumb = buildBreadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Servicios", path: "/servicios" },
  { name: "Desarrollo web y e-commerce", path: "/servicios/desarrollo-web" },
]);

const devFaqs = [
  {
    pregunta: "¿Cuánto sale un desarrollo web?",
    respuesta:
      "Depende del alcance. Como referencia, un sitio institucional arranca en USD 300 en adelante. Después de que nos cuentes tu proyecto —por mail, WhatsApp o una llamada— te confirmamos el precio cerrado exacto.",
  },
  {
    pregunta: "¿Cuánto tardan en arrancar?",
    respuesta:
      "Entre una y dos semanas después de confirmar el precio cerrado. Si tenés algo urgente —el sitio caído, la tienda sin cobrar— lo metemos como primera etapa corta y seguimos con el resto después.",
  },
  {
    pregunta: "¿Trabajan sobre el sitio que ya tengo?",
    respuesta:
      "Sí, es la mayoría de lo que hacemos. Tomamos el WordPress que armó otro equipo, con su tema y sus plugins, y lo corregimos o migramos sin romper lo que ya funciona ni perder posiciones en Google.",
  },
  {
    pregunta: "¿Usan Elementor u otro page builder?",
    respuesta:
      "No. Construimos con el editor de bloques nativo de WordPress y temas propios. Es una decisión técnica, no una limitación: los builders agregan peso que después hay que optimizar.",
  },
  {
    pregunta: "¿Hacen la redacción de los textos del sitio?",
    respuesta:
      "No directamente. Construimos el sitio y te decimos qué espacio de texto necesita cada sección, pero la redacción final es de tu equipo o de quien te maneje el contenido. Podemos coordinar directamente con esa persona si lo necesitás.",
  },
  {
    pregunta: "¿Qué pasa si necesito algo que WordPress no puede hacer sin forzar cambios?",
    respuesta:
      "Ahí evaluamos desarrollo a medida. Te lo decimos desde el primer contacto, antes de cotizar: no vamos a forzar un CMS donde no entra la lógica de tu negocio.",
  },
];

const servicio = homeServicios[0];
const schema = buildGraph(
  organizationSchema,
  breadcrumb,
  buildServiceSchema(servicio),
  buildFaqPageSchema(devFaqs, "/servicios/desarrollo-web")
);

const alcance = [
  {
    num: "01",
    badge: "WP",
    titulo: "WordPress con bloques nativos",
    desc: "Temas propios armados con el editor de bloques (Gutenberg) de WordPress. Sin Elementor, sin Divi, sin WPBakery: los page builders agregan código que no necesitás y le restan velocidad al sitio.",
    nota: "Cada bloque se construye para el proyecto, no se arma con plantillas genéricas.",
  },
  {
    num: "02",
    badge: "EC",
    titulo: "E-commerce",
    desc: "Tiendas con WooCommerce según el volumen y la complejidad del catálogo: carga de productos, checkout, pasarelas de pago y stock sincronizado.",
    nota: "Elegimos la pasarela de pago según tu mercado: Mercado Pago, Todo Pago o la que ya uses.",
  },
  {
    num: "03",
    badge: "AM",
    titulo: "Desarrollo a medida",
    desc: "Cuando la lógica del negocio no entra en un CMS sin forzar cambios de proceso: catálogos complejos, integraciones con sistemas propios, lógicas de precio o stock particulares.",
    nota: "Se evalúa en la primera charla si conviene WordPress o un desarrollo propio, antes de cotizar.",
  },
  {
    num: "04",
    badge: "INT",
    titulo: "Integraciones y APIs",
    desc: "Conectamos el sitio con las herramientas que ya usás —CRM, stock, facturación, pagos u otros sistemas— cuando tienen una API con la que se pueda trabajar.",
    nota: "Si la herramienta no tiene API pública, lo decimos antes de empezar, no a mitad de proyecto.",
  },
  {
    num: "05",
    badge: "MIG",
    titulo: "Migraciones sin caídas",
    desc: "Tomamos un sitio que armó otro equipo y lo migramos de servidor, de tema o de plataforma sin perder posiciones en Google ni tiempo de actividad.",
    nota: "Se hace con el sitio viejo online hasta confirmar que el nuevo funciona igual o mejor.",
  },
];

const entrega = [
  {
    num: "01",
    titulo: "Presupuesto con precio cerrado",
    desc: "Después de la charla de 30 minutos te confirmamos el precio cerrado: alcance dividido en etapas, plazos reales y precio fijo. Sabés qué entra, qué no, y cuándo vas a ver cada parte funcionando.",
    nota: "48 a 72 horas después de la charla inicial.",
  },
  {
    num: "02",
    titulo: "Avances semanales",
    desc: "Un enlace que podés probar cada semana, no recién al final. Ajustamos con tu feedback dentro de lo acordado; si aparece algo nuevo, se cotiza aparte y vos decidís.",
    nota: "2 a 8 semanas según el alcance del proyecto.",
  },
  {
    num: "03",
    titulo: "Lanzamiento y traspaso",
    desc: "Puesta en marcha, capacitación básica y documentación. El código y los accesos quedan a tu nombre desde el día uno.",
    nota: "Soporte mensual opcional después del lanzamiento, sin ataduras.",
  },
];

const stack = ["WordPress", "Gutenberg", "WooCommerce", "Desarrollo a medida"];
---

<BaseLayout
  title={title}
  description={description}
  path="/servicios/desarrollo-web"
  schema={schema}
  noindex={!SERVICIOS_INDEXABLES}>
  <div id="efe-thread-dev" aria-hidden="true" style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:0;pointer-events:none"></div>

  <section id="top" class="efe-section efe-section--tight" style="position:relative">
    <div class="efe-container">
      <div
        style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-bottom:22px;border-bottom:1px solid rgba(255,255,255,.1)"
      >
        <div class="efe-eyebrow" style="margin-bottom:0">Servicio — Desarrollo web</div>
        <div
          style="display:flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8B8B93"
        >
          <a href="/" class="efe-crumb-link">Inicio</a>
          <span>/</span>
          <a href="/servicios/" class="efe-crumb-link">Servicios</a>
          <span>/</span>
          <span style="color:#F5F2EC">Desarrollo web</span>
        </div>
      </div>

      <div class="efe-svc-hero-grid" style="margin-top:clamp(48px,6vw,80px)">
        <div>
          <h1 class="efe-h1" data-reveal>
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.05s">Desarrollo web</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.15s">y e-commerce</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em">
              <span class="efe-word" style="animation-delay:.25s"
                >a medida</span
              >
            </span>
          </h1>

          <p class="efe-lede" data-reveal data-delay="1" style="margin-top:clamp(24px,3vw,34px);max-width:52ch">
            Sitios y tiendas online hechas para <span style="color:#EDEDF0">vender</span>, con temas propios basados en
            bloques nativos de WordPress: catálogo, checkout y pagos que <span style="color:#EDEDF0"
              >funcionan bien en cualquier dispositivo</span
            >.
          </p>

          <div data-reveal data-delay="2" style="display:flex;flex-wrap:wrap;gap:18px;margin-top:clamp(28px,3.4vw,40px)">
            <a href="/contacto/" class="efe-btn efe-btn--primary">Empezar mi proyecto <span style="font-size:14px">↗</span></a>
            <a href="#construimos" class="efe-btn efe-btn--ghost">Qué construimos</a>
          </div>

          <ul data-reveal data-delay="3" style="display:flex;flex-wrap:wrap;gap:10px;margin:28px 0 0;padding:0;list-style:none">
            {stack.map((s) => (
              <li class="efe-tag">{s}</li>
            ))}
          </ul>
        </div>

        <div data-reveal data-delay="1" class="efe-svc-panel">
          <div class="efe-svc-panel__head">
            <span class="efe-svc-panel__dot"></span> Cómo trabajamos
            <span class="efe-svc-panel__badge">Vista previa</span>
          </div>
          {
            entrega.map((row) => (
              <div class="efe-svc-panel__row">
                <p style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:20px;color:#F5F2EC">{row.titulo}</p>
                <p style="margin:8px 0 0;font-size:13.5px;line-height:1.55;color:#8B8B93">{row.desc}</p>
                <p class="efe-svc-panel__tag" style="margin:10px 0 0">{row.nota}</p>
              </div>
            ))
          }
          <a href="#entrega" class="efe-svc-panel__footer">
            Cómo se entrega, paso a paso <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="construimos" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div class="efe-svc-intro-grid">
        <div data-reveal>
          <div class="efe-eyebrow">Alcance del desarrollo</div>
          <h2 class="efe-h2">¿Qué tipo de <br />proyectos hacemos?</h2>
        </div>
        <p class="efe-lede" data-reveal data-delay="1" style="max-width:52ch">
          Trabajamos con WordPress cuando el negocio entra en un CMS estándar, y con desarrollo a medida cuando no.
          En los dos casos, el foco es velocidad, mantenibilidad y que el sitio siga funcionando bien dentro de un
          año, no solo el día del lanzamiento.
        </p>
      </div>

      <div class="efe-svc-grid" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          alcance.map((item) => (
            <div data-scroll="tilt" class="efe-svc-card">
              <div class="efe-svc-card__top">
                <span class="efe-svc-card__num">{item.num}</span>
                <span class="efe-svc-card__badge">{item.badge}</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-svc-card__desc">{item.desc}</p>
              <div class="efe-svc-card__foot">{item.nota}</div>
            </div>
          ))
        }
        <a href="/contacto/" class="efe-svc-cta">
          <div class="efe-svc-cta__eyebrow">Empecemos por tu proyecto</div>
          <h3 class="efe-h3" style="color:#08080A">¿Necesitás un <br />sitio o tienda?</h3>
          <span class="efe-svc-cta__btn">Empezar mi proyecto <span>↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section id="entrega" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div data-reveal>
        <div class="efe-eyebrow">Entrega</div>
        <h2 class="efe-h2">Cómo se <br />entrega</h2>
      </div>

      <div class="efe-grid efe-grid--3" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          entrega.map((item) => (
            <div data-scroll="tilt" class="efe-svc-card">
              <div class="efe-svc-card__top">
                <span class="efe-svc-card__num">{item.num}</span>
                <span class="efe-svc-card__badge">↗</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-svc-card__desc">{item.desc}</p>
              <div class="efe-svc-card__foot">{item.nota}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="preguntas" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(32px,5vw,80px);align-items:start">
      <div data-reveal>
        <div class="efe-eyebrow">Preguntas</div>
        <h2 style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:clamp(34px,5.4vw,82px);line-height:.9;letter-spacing:-.042em">
          Lo que nos <br />preguntan
        </h2>
        <p style="margin:26px 0 0;max-width:32ch;font-size:16.5px;line-height:1.6;color:#8B8B93;text-wrap:pretty">
          Si te queda alguna duda, escribinos: contestamos nosotros, no un bot.
        </p>
      </div>
      <div data-reveal data-delay="1" style="display:flex;flex-direction:column;border-top:1px solid rgba(255,255,255,.12)">
        {
          devFaqs.map((f, i) => (
            <div class="efe-faq-item" style="border-bottom:1px solid rgba(255,255,255,.12)">
              <button type="button" class="efe-faq-toggle" aria-expanded="false" data-index={i}>
                <span class="efe-faq-question">{f.pregunta}</span>
                <span class="efe-faq-icon">+</span>
              </button>
              <div class="efe-faq-panel">
                <p style="margin:0;padding:0 0 26px;min-height:0;overflow:hidden;max-width:58ch;font-size:15.5px;line-height:1.66;color:#8B8B93;text-wrap:pretty">
                  {f.respuesta}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .efe-word {
    display: inline-block;
    animation: efe-rise 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .efe-svc-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(300px, 5fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .efe-svc-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-tag {
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a9a9b1;
  }

  .efe-svc-panel {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0d0d10;
  }
  .efe-svc-panel__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b8b93;
  }
  .efe-svc-panel__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4ff3f;
    animation: efe-pulse 2.2s ease-in-out infinite;
  }
  .efe-svc-panel__badge {
    margin-left: auto;
    color: #f5f2ec;
  }
  .efe-svc-panel__row {
    padding: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .efe-svc-panel__tag {
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #d4ff3f;
  }
  .efe-svc-panel__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 22px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f5f2ec;
    transition: color 0.22s ease;
  }
  .efe-svc-panel__footer:hover {
    color: #d4ff3f;
  }

  .efe-svc-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }
  @media (max-width: 760px) {
    .efe-svc-intro-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 1.8vw, 24px);
  }
  @media (min-width: 720px) {
    .efe-svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .efe-svc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .efe-svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.45s ease, background 0.45s ease, box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-svc-card:hover {
    border-color: #d4ff3f;
    background: #121218;
    box-shadow: 10px 10px 0 rgba(212, 255, 63, 0.85);
    translate: -5px -5px;
  }
  .efe-svc-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .efe-svc-card__num {
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
    color: rgba(245, 242, 236, 0.12);
  }
  .efe-svc-card__badge {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 26px;
    padding: 0 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: #8b8b93;
  }
  .efe-svc-card h3 {
    margin-top: 14px;
  }
  .efe-svc-card__desc {
    margin: 12px 0 0;
    padding-bottom: 10px;
    font-size: 14.5px;
    line-height: 1.58;
    color: #c9c9ce;
  }
  .efe-svc-card__foot {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    line-height: 1.5;
    color: #96969b;
  }

  .efe-svc-cta {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #d4ff3f;
    text-decoration: none;
    transition: transform 0.18s ease;
  }
  .efe-svc-cta:hover {
    transform: translate(-3px, -3px);
  }
  .efe-svc-cta__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #08080a;
  }
  .efe-svc-cta__eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: #08080a;
  }
  .efe-svc-cta h3 {
    margin-top: 16px;
    font-size: clamp(24px, 3vw, 44px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .efe-svc-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(20px, 2.4vw, 30px);
    padding: 15px 22px;
    background: #08080a;
    color: #f5f2ec;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: flex-start;
  }

  /* Acordeón de preguntas — mismo comportamiento que Faq.astro (componente no
     importado en esta página: cada instancia necesita su propia copia). */
  .efe-faq-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding: 24px 0;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: #f5f2ec;
    font-size: clamp(16px, 1.5vw, 19.5px);
    font-weight: 600;
    line-height: 1.34;
    font-family: var(--font-body);
  }
  .efe-faq-question {
    position: relative;
  }
  .efe-faq-question::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: #d4ff3f;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-faq-toggle:hover .efe-faq-question::after {
    transform: scaleX(1);
  }
  .efe-faq-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #8b8b93;
    font-size: 16px;
    line-height: 1;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease, border-color 0.3s ease;
  }
  .efe-faq-toggle:hover .efe-faq-icon {
    border-color: #d4ff3f;
    color: #d4ff3f;
  }
  .efe-faq-panel {
    display: grid;
    grid-template-rows: minmax(0, 0fr);
    min-height: 0;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
    transition: grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.42s;
  }
  .efe-faq-panel > p {
    min-height: 0;
  }
  .efe-faq-item.is-open .efe-faq-icon {
    transform: rotate(135deg);
    color: #d4ff3f;
    border-color: #d4ff3f;
  }
  .efe-faq-item.is-open .efe-faq-panel {
    grid-template-rows: minmax(0, 1fr);
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".efe-faq-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".efe-faq-item");
      if (!item) return;
      const willOpen = !item.classList.contains("is-open");
      item.parentElement?.querySelectorAll(".efe-faq-item.is-open").forEach((open) => {
        open.classList.remove("is-open");
        open.querySelector(".efe-faq-toggle")?.setAttribute("aria-expanded", "false");
      });
      if (willOpen) {
        item.classList.add("is-open");
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
