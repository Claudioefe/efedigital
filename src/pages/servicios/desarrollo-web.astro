---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { serviciosDesarrolloWeb, desarrolloWebAMedida } from "../../data/desarrolloWeb";
import { buildGraph, organizationSchema, desarrolloWebServiceSchema } from "../../data/schema";

const title = "Desarrollo Web & Ecommerce | efedigital";
const description =
  "Sitios corporativos, ecommerce, landing pages y rediseño web. Diseño responsivo, SEO optimizado y panel de administración fácil de usar.";
const schema = buildGraph(organizationSchema, desarrolloWebServiceSchema);
---

<BaseLayout title={title} description={description} path="/servicios/desarrollo-web" schema={schema} noindex>
  <section class="efe-section">
      <div class="efe-container">
        <div class="efe-eyebrow" data-reveal>Desarrollo Web & Ecommerce</div>
        <h1 class="efe-h2" data-reveal data-delay="1">Sitios y tiendas<br />hechos para vender</h1>
        <p class="efe-lede" style="margin-top:22px;max-width:56ch">
          Creamos sitios web profesionales y tiendas online que convierten visitantes en clientes, con
          temas propios basados en bloques (Gutenberg) y todo optimizado para SEO desde el primer día.
        </p>

        <div class="efe-grid--3" data-stagger data-sync style="margin-top:clamp(40px,5vw,64px)">
          {
            serviciosDesarrolloWeb.map((s) => (
              <div data-scroll="tilt" data-spotlight class="efe-card">
                <div class="efe-card__glow" data-glow />
                <h2 class="efe-h3" style="position:relative">{s.titulo}</h2>
                <p style="position:relative;margin:0;font-size:15.5px;line-height:1.55;color:#F5F2EC;text-wrap:pretty">
                  {s.descripcionBreve}
                </p>
                <ul style="position:relative;margin:auto 0 0;padding-top:16px;border-top:1px solid rgba(255,255,255,.12);list-style:none;display:flex;flex-direction:column;gap:8px">
                  {s.diagramaFlujo.map((paso) => (
                    <li style="font-size:13px;line-height:1.5;color:#8B8B93;display:flex;gap:8px">
                      <span style="color:#D4FF3F">→</span>
                      {paso}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div
          data-reveal
          style="margin-top:clamp(56px,7vw,96px);padding:clamp(28px,3.5vw,52px);border:1px solid rgba(255,255,255,.12);background:#0F0F13"
        >
          <h2 style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:clamp(26px,3.6vw,48px);line-height:1;letter-spacing:-.03em">
            {desarrolloWebAMedida.titulo} <span style="color:#D4FF3F">{desarrolloWebAMedida.tituloDestacado}</span>
          </h2>
          <p style="margin:20px 0 0;max-width:70ch;font-size:16px;line-height:1.6;color:#A9A9B1">
            {desarrolloWebAMedida.descripcion}
          </p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin-top:32px">
            {
              desarrolloWebAMedida.servicios.map((item) => (
                <div style="padding:22px;border:1px solid rgba(255,255,255,.1);background:#141419">
                  <h3 style="margin:0 0 10px;font-size:18px;color:#F5F2EC">{item.titulo}</h3>
                  <p style="margin:0;font-size:14.5px;line-height:1.55;color:#8B8B93">{item.descripcion}</p>
                </div>
              ))
            }
          </div>
          <p style="margin:32px 0 0;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.06em;color:#8B8B93">
            {desarrolloWebAMedida.cierre}
          </p>
        </div>

        <div style="margin-top:clamp(40px,5vw,64px)">
          <a href="/contacto" class="efe-btn efe-btn--primary">Empezar un proyecto <span style="font-size:14px">↗</span></a>
        </div>
      </div>
    </section>
</BaseLayout>

<style>
  [data-scroll="tilt"]:hover {
    border-color: #d4ff3f;
    background: #121218;
    box-shadow: 10px 10px 0 rgba(212, 255, 63, 0.85);
    translate: -5px -5px;
  }
</style>
