---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { productosAutomatizacion, desarrolloAMedida } from "../../data/automatizaciones";
import { buildGraph, organizationSchema, automatizacionesServiceSchema } from "../../data/schema";

const title = "Automatización Inteligente & IA | efedigital";
const description =
  "Flujos de trabajo con n8n, agentes de IA y automatizaciones que funcionan 24/7 sin intervención humana: notificaciones, sincronización de datos, facturación y más.";
const schema = buildGraph(organizationSchema, automatizacionesServiceSchema);
---

<BaseLayout title={title} description={description} path="/servicios/automatizaciones" schema={schema} noindex>
  <section class="efe-section">
      <div class="efe-container">
        <div class="efe-eyebrow" data-reveal>Automatización Inteligente</div>
        <h1 class="efe-h2" data-reveal data-delay="1">Sistemas que<br />trabajan solos</h1>
        <p class="efe-lede" style="margin-top:22px;max-width:56ch">
          Flujos a medida con n8n que conectan tus herramientas y sacan las tareas repetitivas de encima,
          24 horas al día, sin intervención humana.
        </p>

        <div class="efe-grid--3" data-stagger data-sync style="margin-top:clamp(40px,5vw,64px)">
          {
            productosAutomatizacion.map((p) => (
              <div data-scroll="tilt" data-spotlight class="efe-card">
                <div class="efe-card__glow" data-glow />
                <div style="position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
                  <h2 class="efe-h3">{p.titulo}</h2>
                  {p.precio && (
                    <span style="flex:none;font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:.05em;color:#D4FF3F">
                      desde {p.precio}
                    </span>
                  )}
                </div>
                <p style="position:relative;margin:0;font-size:15.5px;line-height:1.55;color:#F5F2EC;text-wrap:pretty">
                  {p.descripcionBreve}
                </p>
                <ul style="position:relative;margin:auto 0 0;padding-top:16px;border-top:1px solid rgba(255,255,255,.12);list-style:none;display:flex;flex-direction:column;gap:8px">
                  {p.queHace.slice(0, 3).map((linea) => (
                    <li style="font-size:13px;line-height:1.5;color:#8B8B93;display:flex;gap:8px">
                      <span style="color:#D4FF3F">→</span>
                      {linea}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div
          data-reveal
          style="margin-top:clamp(56px,7vw,96px);padding:clamp(28px,3.5vw,52px);border:1px solid rgba(255,255,255,.12);background:#0F0F13"
        >
          <h2 style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:clamp(26px,3.6vw,48px);line-height:1;letter-spacing:-.03em">
            {desarrolloAMedida.titulo} <span style="color:#D4FF3F">{desarrolloAMedida.tituloDestacado}</span>
          </h2>
          <p style="margin:20px 0 0;max-width:70ch;font-size:16px;line-height:1.6;color:#A9A9B1">
            {desarrolloAMedida.descripcion}
          </p>
          <p style="margin:32px 0 0;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.06em;color:#8B8B93">
            {desarrolloAMedida.cierre}
          </p>
        </div>

        <div style="margin-top:clamp(40px,5vw,64px)">
          <a href="/contacto" class="efe-btn efe-btn--primary">Empezar un proyecto <span style="font-size:14px">↗</span></a>
        </div>
      </div>
    </section>
</BaseLayout>

<style>
  [data-scroll="tilt"]:hover {
    border-color: #d4ff3f;
    background: #121218;
    box-shadow: 10px 10px 0 rgba(212, 255, 63, 0.85);
    translate: -5px -5px;
  }
</style>
