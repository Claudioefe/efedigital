---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildGraph,
  organizationSchema,
  buildBreadcrumbSchema,
  buildFaqPageSchema,
  buildServiceSchema,
} from "../../data/schema";
import { homeServicios } from "../../data/home-servicios";
import { SERVICIOS_INDEXABLES } from "../../data/site-config";

const title = "Mantenimiento y Soporte Técnico WordPress | efedigital";
const description =
  "Actualizaciones, backups, monitoreo y seguridad para que tu sitio siga funcionando sin sorpresas, sin que tengas que pensarlo vos. Desde USD 100 por mes.";

const breadcrumb = buildBreadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Servicios", path: "/servicios" },
  { name: "Mantenimiento y soporte", path: "/servicios/mantenimiento" },
]);

const mantenimientoFaqs = [
  {
    pregunta: "¿Cuánto sale el mantenimiento mensual?",
    respuesta:
      "Depende de las horas que necesite tu sitio según su tamaño y actividad. Como referencia, un plan básico arranca en USD 100 por mes. Te lo confirmamos con precio cerrado después de que nos cuentes tu caso, por mail, WhatsApp o una llamada.",
  },
  {
    pregunta: "¿Qué pasa si necesito algo urgente fuera de las horas del plan?",
    respuesta:
      "Se atiende igual. Si el sitio se cae o hay un problema de seguridad, no esperamos al mes que viene: lo resolvemos y, si excede las horas del plan, te avisamos antes de sumar el costo extra.",
  },
  {
    pregunta: "¿Tengo que contratar el hosting con ustedes?",
    respuesta:
      "No. Configuramos y mantenemos el hosting que vos elijas, a tu nombre. Si no tenés uno todavía, te recomendamos opciones, pero la cuenta siempre queda tuya.",
  },
  {
    pregunta: "¿Qué pasa si me sobran horas un mes?",
    respuesta:
      "No se acumulan de forma indefinida, pero se pueden usar en ajustes menores dentro del mismo mes (textos, imágenes, pequeños cambios) en vez de perderse.",
  },
  {
    pregunta: "¿Puedo empezar el mantenimiento si el sitio lo hizo otro equipo?",
    respuesta:
      "Sí, es un caso común. Antes de arrancar hacemos una revisión inicial del sitio (plugins, versión de WordPress, seguridad) para saber desde dónde partimos, y a partir de ahí sigue el mantenimiento normal.",
  },
  {
    pregunta: "¿Esto reemplaza a la auditoría técnica o a la optimización de velocidad?",
    respuesta:
      "No, son complementarios. La auditoría técnica detecta qué está mal en el sitio (SEO técnico, GEO y AEO); la optimización de velocidad corrige puntualmente el rendimiento. El mantenimiento es lo que viene después: mantiene todo eso actualizado, seguro y funcionando mes a mes, para no tener que repetir el diagnóstico de cero.",
  },
];

const servicio = homeServicios[1];
const schema = buildGraph(
  organizationSchema,
  breadcrumb,
  buildServiceSchema(servicio),
  buildFaqPageSchema(mantenimientoFaqs, "/servicios/mantenimiento")
);

const incluye = [
  {
    num: "01",
    badge: "UPD",
    titulo: "Actualizaciones",
    desc: "WordPress, plugins y tema actualizados a las versiones más nuevas, probando antes en un entorno de prueba para que una actualización no rompa nada en el sitio en vivo.",
    nota: "Se prueba primero en staging, no directo en producción.",
  },
  {
    num: "02",
    badge: "BKP",
    titulo: "Backups",
    desc: "Copias de seguridad automáticas y verificadas, guardadas fuera del propio servidor, para poder volver atrás rápido si algo sale mal.",
    nota: "No alcanza con la copia que guarda el hosting; se guarda aparte.",
  },
  {
    num: "03",
    badge: "SEC",
    titulo: "Monitoreo y seguridad",
    desc: "Chequeo de que el sitio esté online, escaneo de malware y cierre de vulnerabilidades conocidas antes de que alguien las aproveche.",
    nota: "Alertas automáticas si el sitio se cae o empieza a tirar errores.",
  },
  {
    num: "04",
    badge: "DEV",
    titulo: "Ajustes y plugins a medida",
    desc: "Arreglo de conflictos entre plugins, ajustes puntuales de funcionalidad e integraciones por API que se rompieron con una actualización.",
    nota: "Con las horas del plan mensual, sin cotizar cada cambio chico por separado.",
  },
  {
    num: "05",
    badge: "SSL",
    titulo: "SSL y dominio al día",
    desc: "Vigilamos que el certificado SSL no venza y que la configuración de DNS del dominio siga siendo la correcta, para que el sitio no aparezca como \"no seguro\" de un día para el otro.",
    nota: "Chequeo periódico, no solo cuando ya venció y alguien te avisa.",
  },
];

const entrega = [
  {
    num: "01",
    titulo: "Plan armado a medida",
    desc: "Definimos las horas mensuales según el tamaño y la actividad del sitio, no un plan genérico que te sobra o te queda corto.",
    nota: "Se ajusta en la charla inicial, y se puede revisar más adelante si el sitio crece.",
  },
  {
    num: "02",
    titulo: "Reporte mensual",
    desc: "Cada mes te mandamos qué se actualizó, qué se corrigió y qué recomendamos para el próximo, para que sepas en qué se usaron las horas.",
    nota: 'Sin sorpresas ni "confiá en que hicimos algo": queda todo por escrito.',
  },
  {
    num: "03",
    titulo: "Mes a mes, sin ataduras",
    desc: "Sin contrato de permanencia. Si en algún momento no lo necesitás más, lo das de baja y listo.",
    nota: "El sitio, con todo lo actualizado hasta ese momento, sigue siendo tuyo.",
  },
];

const herramientas = ["Actualizaciones", "Backups", "Monitoreo", "Seguridad", "SSL"];
---

<BaseLayout
  title={title}
  description={description}
  path="/servicios/mantenimiento"
  schema={schema}
  noindex={!SERVICIOS_INDEXABLES}>
  <div id="efe-thread-mant" aria-hidden="true" style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:0;pointer-events:none"></div>

  <section id="top" class="efe-section efe-section--tight" style="position:relative">
    <div class="efe-container">
      <div
        style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-bottom:22px;border-bottom:1px solid rgba(255,255,255,.1)"
      >
        <div class="efe-eyebrow" style="margin-bottom:0">Servicio — Mantenimiento técnico</div>
        <div
          style="display:flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8B8B93"
        >
          <a href="/" class="efe-crumb-link">Inicio</a>
          <span>/</span>
          <a href="/servicios/" class="efe-crumb-link">Servicios</a>
          <span>/</span>
          <span style="color:#F5F2EC">Mantenimiento</span>
        </div>
      </div>

      <div class="efe-svc-hero-grid" style="margin-top:clamp(48px,6vw,80px)">
        <div>
          <h1 class="efe-h1" data-reveal>
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.05s">Mantenimiento</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.15s">y soporte</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em">
              <span class="efe-word" style="animation-delay:.25s"
                >técnico</span
              >
            </span>
          </h1>

          <p class="efe-lede" data-reveal data-delay="1" style="margin-top:clamp(24px,3vw,34px);max-width:52ch">
            Actualización de plugins, monitoreo, respaldos y mejoras técnicas para que tu sitio <span style="color:#EDEDF0"
              >siga funcionando, seguro y sin sorpresas</span
            >, sin que tengas que pensarlo vos.
          </p>

          <div data-reveal data-delay="2" style="display:flex;flex-wrap:wrap;gap:18px;margin-top:clamp(28px,3.4vw,40px)">
            <a href="/contacto/" class="efe-btn efe-btn--primary">Armar mi plan <span style="font-size:14px">↗</span></a>
            <a href="#incluye" class="efe-btn efe-btn--ghost">Qué incluye</a>
          </div>

          <blockquote
            data-reveal
            data-delay="2"
            style="margin:clamp(28px,3.4vw,40px) 0 0;padding-left:18px;border-left:2px solid #D4FF3F;font-family:'JetBrains Mono',monospace;font-size:13px;line-height:1.65;color:#A9A9B1;max-width:52ch"
          >
            Plan mensual con horas incluidas, armado según lo que necesites. Mes a mes, sin contrato de permanencia.
            Te lo confirmamos en una llamada de 30 minutos sin costo.
          </blockquote>

          <ul data-reveal data-delay="3" style="display:flex;flex-wrap:wrap;gap:10px;margin:28px 0 0;padding:0;list-style:none">
            {herramientas.map((h) => (
              <li class="efe-tag">{h}</li>
            ))}
          </ul>
        </div>

        <div data-reveal data-delay="1" class="efe-svc-panel">
          <div class="efe-svc-panel__head">
            <span class="efe-svc-panel__dot"></span> Qué incluye el plan
            <span class="efe-svc-panel__badge">Vista previa</span>
          </div>
          {
            incluye.slice(0, 3).map((row) => (
              <div class="efe-svc-panel__row">
                <p style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:18px;color:#F5F2EC">{row.titulo}</p>
                <p style="margin:8px 0 0;font-size:13.5px;line-height:1.55;color:#8B8B93">{row.desc}</p>
              </div>
            ))
          }
          <a href="#incluye" class="efe-svc-panel__footer">
            Ver todo lo que incluye <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="incluye" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div class="efe-svc-intro-grid" style="grid-template-columns:minmax(0,3fr) minmax(0,2fr)">
        <div data-reveal>
          <div class="efe-eyebrow">01 — Qué incluye</div>
          <h2 class="efe-h2">¿Qué hacemos <br />mensualmente <br />en tu sitio?</h2>
        </div>
        <p class="efe-lede" data-reveal data-delay="1" style="max-width:52ch">
          Un sitio no se termina el día que se publica. WordPress, los plugins y el servidor cambian todo el
          tiempo, y si nadie los sigue, tarde o temprano algo se rompe o queda expuesto. El plan mensual existe
          para que eso lo manejemos nosotros.
        </p>
      </div>

      <div class="efe-svc-grid" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          incluye.map((item) => (
            <div data-scroll="tilt" class="efe-svc-card">
              <div class="efe-svc-card__top">
                <span class="efe-svc-card__num">{item.num}</span>
                <span class="efe-svc-card__badge">{item.badge}</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-svc-card__desc">{item.desc}</p>
              <div class="efe-svc-card__foot">{item.nota}</div>
            </div>
          ))
        }
        <a href="/contacto/" class="efe-svc-cta">
          <div class="efe-svc-cta__eyebrow">Empecemos por tu sitio</div>
          <h3 class="efe-h3" style="color:#08080A">¿Necesitás un <br />plan de mantenimiento?</h3>
          <span class="efe-svc-cta__btn">Armar mi plan <span>↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section id="entrega" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div data-reveal>
        <div class="efe-eyebrow">03 — Entrega</div>
        <h2 class="efe-h2">Cómo funciona <br />el plan</h2>
      </div>

      <div class="efe-grid efe-grid--3" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          entrega.map((item) => (
            <div data-scroll="tilt" class="efe-svc-card">
              <div class="efe-svc-card__top">
                <span class="efe-svc-card__num">{item.num}</span>
                <span class="efe-svc-card__badge">↗</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-svc-card__desc">{item.desc}</p>
              <div class="efe-svc-card__foot">{item.nota}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="preguntas" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(32px,5vw,80px);align-items:start">
      <div data-reveal>
        <div class="efe-eyebrow">04 — Preguntas</div>
        <h2 style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:clamp(34px,5.4vw,82px);line-height:.9;letter-spacing:-.042em">
          Lo que nos <br />preguntan
        </h2>
        <p style="margin:26px 0 0;max-width:32ch;font-size:16.5px;line-height:1.6;color:#8B8B93;text-wrap:pretty">
          Si te queda alguna duda, escribinos: contestamos nosotros, no un bot.
        </p>
      </div>
      <div data-reveal data-delay="1" style="display:flex;flex-direction:column;border-top:1px solid rgba(255,255,255,.12)">
        {
          mantenimientoFaqs.map((f, i) => (
            <div class="efe-faq-item" style="border-bottom:1px solid rgba(255,255,255,.12)">
              <button type="button" class="efe-faq-toggle" aria-expanded="false" data-index={i}>
                <span class="efe-faq-question">{f.pregunta}</span>
                <span class="efe-faq-icon">+</span>
              </button>
              <div class="efe-faq-panel">
                <p style="margin:0;padding:0 0 26px;min-height:0;overflow:hidden;max-width:58ch;font-size:15.5px;line-height:1.66;color:#8B8B93;text-wrap:pretty">
                  {f.respuesta}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .efe-word {
    display: inline-block;
    animation: efe-rise 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .efe-svc-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(300px, 5fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .efe-svc-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-tag {
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a9a9b1;
  }

  .efe-svc-panel {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0d0d10;
  }
  .efe-svc-panel__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b8b93;
  }
  .efe-svc-panel__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4ff3f;
    animation: efe-pulse 2.2s ease-in-out infinite;
  }
  .efe-svc-panel__badge {
    margin-left: auto;
    color: #f5f2ec;
  }
  .efe-svc-panel__row {
    padding: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .efe-svc-panel__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 22px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f5f2ec;
    transition: color 0.22s ease;
  }
  .efe-svc-panel__footer:hover {
    color: #d4ff3f;
  }

  .efe-svc-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }
  @media (max-width: 760px) {
    .efe-svc-intro-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 1.8vw, 24px);
  }
  @media (min-width: 720px) {
    .efe-svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .efe-svc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .efe-svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.45s ease, background 0.45s ease, box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-svc-card:hover {
    border-color: #d4ff3f;
    background: #121218;
    box-shadow: 10px 10px 0 rgba(212, 255, 63, 0.85);
    translate: -5px -5px;
  }
  .efe-svc-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .efe-svc-card__num {
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
    color: rgba(245, 242, 236, 0.12);
  }
  .efe-svc-card__badge {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 26px;
    padding: 0 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: #8b8b93;
  }
  .efe-svc-card h3 {
    margin-top: 14px;
  }
  .efe-svc-card__desc {
    margin: 12px 0 0;
    padding-bottom: 10px;
    font-size: 14.5px;
    line-height: 1.58;
    color: #c9c9ce;
  }
  .efe-svc-card__foot {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    line-height: 1.5;
    color: #96969b;
  }

  .efe-svc-cta {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #d4ff3f;
    text-decoration: none;
    transition: transform 0.18s ease;
  }
  .efe-svc-cta:hover {
    transform: translate(-3px, -3px);
  }
  .efe-svc-cta__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #08080a;
  }
  .efe-svc-cta__eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: #08080a;
  }
  .efe-svc-cta h3 {
    margin-top: 16px;
    font-size: clamp(24px, 3vw, 44px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .efe-svc-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(20px, 2.4vw, 30px);
    padding: 15px 22px;
    background: #08080a;
    color: #f5f2ec;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: flex-start;
  }

  /* Acordeón de preguntas — mismo comportamiento que Faq.astro (componente no
     importado en esta página: cada instancia necesita su propia copia). */
  .efe-faq-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding: 24px 0;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: #f5f2ec;
    font-size: clamp(16px, 1.5vw, 19.5px);
    font-weight: 600;
    line-height: 1.34;
    font-family: var(--font-body);
  }
  .efe-faq-question {
    position: relative;
  }
  .efe-faq-question::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: #d4ff3f;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-faq-toggle:hover .efe-faq-question::after {
    transform: scaleX(1);
  }
  .efe-faq-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #8b8b93;
    font-size: 16px;
    line-height: 1;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease, border-color 0.3s ease;
  }
  .efe-faq-toggle:hover .efe-faq-icon {
    border-color: #d4ff3f;
    color: #d4ff3f;
  }
  .efe-faq-panel {
    display: grid;
    grid-template-rows: minmax(0, 0fr);
    min-height: 0;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
    transition: grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.42s;
  }
  .efe-faq-panel > p {
    min-height: 0;
  }
  .efe-faq-item.is-open .efe-faq-icon {
    transform: rotate(135deg);
    color: #d4ff3f;
    border-color: #d4ff3f;
  }
  .efe-faq-item.is-open .efe-faq-panel {
    grid-template-rows: minmax(0, 1fr);
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".efe-faq-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".efe-faq-item");
      if (!item) return;
      const willOpen = !item.classList.contains("is-open");
      item.parentElement?.querySelectorAll(".efe-faq-item.is-open").forEach((open) => {
        open.classList.remove("is-open");
        open.querySelector(".efe-faq-toggle")?.setAttribute("aria-expanded", "false");
      });
      if (willOpen) {
        item.classList.add("is-open");
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
