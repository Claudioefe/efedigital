---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import EnfoqueGrid from "../components/EnfoqueGrid.astro";
import BlogPreview from "../components/BlogPreview.astro";
import Faq from "../components/Faq.astro";
import LogoAnimado from "../components/LogoAnimado.astro";
import { buildGraph, organizationSchema, websiteSchema, buildFaqPageSchema } from "../data/schema";
import { faqs } from "../data/home-faqs";

const title = "Desarrollo web, automatización e IA | efedigital";
const description =
  "Sistemas que trabajan solos. Desarrollo web, automatización e inteligencia artificial para tu negocio. E-commerce, integraciones API y soluciones a medida.";
const schema = buildGraph(organizationSchema, websiteSchema, buildFaqPageSchema(faqs));
---

<BaseLayout title={title} description={description} path="/" schema={schema}>
  <div id="efe-thread" aria-hidden="true" style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:0;pointer-events:none"></div>

  <div aria-hidden="true" style="position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden">
    <div
      style="position:absolute;left:calc(6% + var(--efe-p,0) * 62%);top:calc(14% + var(--efe-p,0) * 48%);width:min(58vw,720px);height:min(58vw,720px);margin:-14% 0 0 -14%;border-radius:50%;background:radial-gradient(closest-side,rgba(212,255,63,.15),transparent 70%);filter:blur(30px);scale:calc(.85 + var(--efe-p,0) * .5)"
    >
    </div>
    <div
      style="position:absolute;right:-10%;top:calc(60% - var(--efe-p,0) * 55%);width:min(40vw,460px);height:min(40vw,460px);border-radius:50%;border:1px solid rgba(212,255,63,.16);rotate:calc(var(--efe-p,0) * 320deg)"
    >
    </div>
  </div>

  <div id="efe-intro" aria-hidden="true" style="position:fixed;inset:0;z-index:9500;pointer-events:none;opacity:0">
    <div id="efe-intro-bg" style="position:absolute;inset:0;background:#08080A;transition:opacity .8s cubic-bezier(.16,1,.3,1)"></div>
    <div
      id="efe-intro-logo"
      style="position:absolute;left:50%;top:50%;translate:-50% -50%;transition:opacity .55s ease"
    >
      <LogoAnimado uid="intro" style="width:min(72vw,430px)" />
    </div>
    <div id="efe-intro-flash" style="position:absolute;inset:0;background:#D4FF3F;opacity:0;transition:opacity .16s ease"></div>
    <div data-intro-corner="tl" style="position:absolute;width:26px;height:26px;border-left:1px solid #D4FF3F;border-top:1px solid #D4FF3F"></div>
    <div data-intro-corner="tr" style="position:absolute;width:26px;height:26px;border-right:1px solid #D4FF3F;border-top:1px solid #D4FF3F"></div>
    <div data-intro-corner="bl" style="position:absolute;width:26px;height:26px;border-left:1px solid #D4FF3F;border-bottom:1px solid #D4FF3F"></div>
    <div data-intro-corner="br" style="position:absolute;width:26px;height:26px;border-right:1px solid #D4FF3F;border-bottom:1px solid #D4FF3F"></div>
  </div>

  <Hero />

  <div class="efe-marquee">
    <div class="efe-marquee__track">
      <div class="efe-marquee__group">
        <span>Menos planillas</span><span style="opacity:.5">✱</span><span>Menos copy-paste</span
        ><span style="opacity:.5">✱</span><span>Más margen</span><span style="opacity:.5">✱</span>
      </div>
      <div aria-hidden="true" class="efe-marquee__group">
        <span>Menos planillas</span><span style="opacity:.5">✱</span><span>Menos copy-paste</span
        ><span style="opacity:.5">✱</span><span>Más margen</span><span style="opacity:.5">✱</span>
      </div>
    </div>
  </div>

  <ServicesGrid />
  <ProcessSteps />
  <EnfoqueGrid />
  <BlogPreview />
  <Faq />
</BaseLayout>
