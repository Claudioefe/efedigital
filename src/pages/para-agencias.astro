---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeServicios } from "../data/home-servicios";
import {
  buildGraph,
  organizationSchema,
  buildBreadcrumbSchema,
  buildFaqPageSchema,
  pageUrl,
} from "../data/schema";

const title = "WordPress para agencias, en marca blanca | efedigital";
const description =
  "Somos el equipo técnico de tu agencia: desarrollo WordPress, mantenimiento, optimización y SEO técnico, bajo tu marca o como partner. Desde USD 100.";

const [dev, mant, opt, audit, auto] = homeServicios;
const precio = (s: (typeof homeServicios)[number]) => `Desde USD ${s.desde}${s.unidad === "mes" ? " por mes" : ""}`;

const derivar = [
  {
    num: "01",
    badge: "DEV",
    servicio: dev,
    titulo: "Desarrollo WordPress y a medida",
    desc: "Sitios, tiendas y plugins para los proyectos que tu agencia vende y no quiere programar: temas propios en bloques, integraciones por API y migraciones sin caídas.",
  },
  {
    num: "02",
    badge: "MNT",
    servicio: mant,
    titulo: "Mantenimiento de los sitios de tus clientes",
    desc: "Actualizaciones, backups, monitoreo y seguridad de toda tu cartera, con horas mensuales y sin contrato de permanencia.",
  },
  {
    num: "03",
    badge: "CWV",
    servicio: opt,
    titulo: "Velocidad y Core Web Vitals",
    desc: "Cuando un cliente se queja de que su sitio es lento, lo medimos, lo corregimos y te devolvemos las métricas de antes y después para que se las muestres.",
  },
  {
    num: "04",
    badge: "SEO",
    servicio: audit,
    titulo: "Auditoría técnica para tu equipo de SEO",
    desc: "Un informe de datos estructurados, indexación, arquitectura y legibilidad para IA, priorizado por impacto. Tu equipo lo ejecuta o nosotros lo implementamos.",
  },
  {
    num: "05",
    badge: "AUTO",
    servicio: auto,
    titulo: "Automatizaciones y reportes",
    desc: "Flujos que sacan tareas manuales de tu operación, como los reportes de campañas por cliente armados solos con los datos de cada cuenta.",
  },
];

const trabajo = [
  {
    num: "01",
    titulo: "Nos contás el proyecto",
    desc: "Por mail, WhatsApp o una llamada: qué necesita el cliente, qué herramientas usa y para cuándo. Nos alcanza con un brief corto.",
    nota: "Te decimos si es viable antes de cotizar nada.",
  },
  {
    num: "02",
    titulo: "Precio cerrado y avances semanales",
    desc: "Cotizamos con precio cerrado por etapa y te pasamos un enlace para probar cada semana, así le mostrás avances a tu cliente sin esperar al final.",
    nota: "Si aparece algo nuevo, se cotiza aparte y vos decidís.",
  },
  {
    num: "03",
    titulo: "Entrega a quien indiques",
    desc: "El código, los accesos y la documentación quedan a nombre de tu agencia o de tu cliente, según prefieras, para que nadie dependa de nosotros para que funcione.",
    nota: "Soporte mensual opcional después de la entrega.",
  },
];

const porque = [
  {
    num: "01",
    titulo: "Hablás con quien hace el trabajo",
    desc: "Sin intermediarios ni gerentes de cuenta: el canal es directo con quien programa, y las dudas se resuelven en el momento.",
  },
  {
    num: "02",
    titulo: "WordPress sin page builders",
    desc: "Temas propios en bloques nativos: sitios más livianos y más fáciles de mantener que los armados con Elementor o Divi.",
  },
  {
    num: "03",
    titulo: "Pensado para SEO y para IA",
    desc: "Datos estructurados, velocidad y rastreabilidad cuidados desde la base, para que el trabajo de tu equipo de SEO rinda más.",
  },
];

const faqs = [
  {
    pregunta: "¿Mi cliente va a saber que trabajan conmigo?",
    respuesta:
      "Eso lo elegís vos, proyecto por proyecto. En marca blanca trabajamos bajo la marca de tu agencia y no hablamos con tu cliente. Como partner visible figuramos como tu proveedor técnico y, si vos lo autorizás, hablamos directo con él.",
  },
  {
    pregunta: "¿Cuánto sale?",
    respuesta:
      "Los precios son los mismos de referencia que figuran en cada servicio: desde USD 100 una auditoría técnica o un mes de mantenimiento, desde USD 300 un sitio institucional, una optimización o una automatización, y desde USD 500 una tienda. El precio final depende del alcance y te lo confirmamos antes de arrancar.",
  },
  {
    pregunta: "¿Puedo derivarles un solo proyecto o tengo que comprometerme con un volumen?",
    respuesta:
      "Podés empezar con un solo proyecto. El mantenimiento es mes a mes, sin contrato de permanencia.",
  },
  {
    pregunta: "¿Hacen SEO o estrategia de contenido?",
    respuesta:
      "No, y por eso no competimos con tu agencia. Nos ocupamos de la parte técnica: código, servidor, velocidad y datos estructurados. La estrategia y el contenido quedan de tu lado.",
  },
  {
    pregunta: "¿Cómo nos coordinamos?",
    respuesta:
      "Por mail, WhatsApp o videollamada, lo que prefiera tu equipo. Trabajás con quien hace el trabajo y ves avances en un enlace cada semana.",
  },
  {
    pregunta: "¿Quién queda como dueño del código y los accesos?",
    respuesta:
      "Quien vos indiques: tu agencia o tu cliente. El código, los accesos y la documentación se entregan a ese nombre desde el día uno.",
  },
];

const breadcrumb = buildBreadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Para agencias", path: "/para-agencias" },
]);

const servicioAgencias = {
  "@type": "Service",
  "@id": `${pageUrl("/para-agencias")}#service`,
  name: "Equipo técnico WordPress para agencias",
  description,
  url: pageUrl("/para-agencias"),
  serviceType: ["Desarrollo WordPress en marca blanca", "Mantenimiento web", "SEO técnico", "Desarrollo a medida"],
  audience: { "@type": "BusinessAudience", audienceType: "Agencias de marketing, SEO y diseño web" },
  provider: { "@id": `${pageUrl("/")}#organization` },
  areaServed: "Worldwide",
  offers: {
    "@type": "Offer",
    url: pageUrl("/para-agencias"),
    priceCurrency: "USD",
    priceSpecification: { "@type": "PriceSpecification", priceCurrency: "USD", minPrice: 100 },
  },
};

const schema = buildGraph(organizationSchema, breadcrumb, servicioAgencias, buildFaqPageSchema(faqs, "/para-agencias"));
---

<BaseLayout title={title} description={description} path="/para-agencias" schema={schema}>
  <div id="efe-thread-ag" aria-hidden="true" style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:0;pointer-events:none"></div>

  <section id="top" class="efe-section efe-section--tight" style="position:relative">
    <div class="efe-container">
      <div
        style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-bottom:22px;border-bottom:1px solid rgba(255,255,255,.1)"
      >
        <div class="efe-eyebrow" style="margin-bottom:0">Para agencias</div>
        <div
          style="display:flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8B8B93"
        >
          <a href="/" class="efe-crumb-link">Inicio</a>
          <span>/</span>
          <span style="color:#F5F2EC">Para agencias</span>
        </div>
      </div>

      <div class="efe-svc-hero-grid" style="margin-top:clamp(48px,6vw,80px)">
        <div>
          <h1 class="efe-h1" data-reveal>
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.05s">El equipo técnico</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.15s">de tu agencia,</span></span
            >
            {" "}
            <span style="display:block;overflow:hidden;padding-bottom:.06em"
              ><span class="efe-word" style="animation-delay:.25s">sin sumar sueldos</span></span
            >
          </h1>

          <p class="efe-lede" data-reveal data-delay="1" style="margin-top:clamp(24px,3vw,34px);max-width:52ch">
            Si tu agencia vende sitios, SEO o marketing y no querés ampliar el equipo de desarrollo, nosotros nos
            ocupamos de <span style="color:#EDEDF0">WordPress, mantenimiento, velocidad y desarrollo a medida</span>. Vos
            te quedás con <span style="color:#EDEDF0">el cliente y la estrategia</span>.
          </p>

          <div data-reveal data-delay="2" style="display:flex;flex-wrap:wrap;gap:18px;margin-top:clamp(28px,3.4vw,40px)">
            <a href="/contacto/" class="efe-btn efe-btn--primary">Contanos tu caso <span style="font-size:14px">↗</span></a>
            <a href="#derivar" class="efe-btn efe-btn--ghost">Qué podés derivarnos</a>
          </div>

          <ul data-reveal data-delay="3" style="display:flex;flex-wrap:wrap;gap:10px;margin:28px 0 0;padding:0;list-style:none">
            {["Marca blanca", "Partner visible", "WordPress", "SEO técnico", "A medida"].map((c) => (
              <li class="efe-tag">{c}</li>
            ))}
          </ul>
        </div>

        <div data-reveal data-delay="1" class="efe-svc-panel">
          <div class="efe-svc-panel__head">
            <span class="efe-svc-panel__dot"></span> Dos formas de trabajar
            <span class="efe-svc-panel__badge">A tu elección</span>
          </div>
          <div class="efe-svc-panel__row">
            <p class="efe-svc-panel__title">Marca blanca</p>
            <p class="efe-svc-panel__text">
              Trabajamos bajo la marca de tu agencia y no hablamos con tu cliente. Vos ponés la cara, nosotros el
              código.
            </p>
          </div>
          <div class="efe-svc-panel__row">
            <p class="efe-svc-panel__title">Partner visible</p>
            <p class="efe-svc-panel__text">
              Figuramos como tu proveedor técnico y, si vos lo autorizás, hablamos directo con tu cliente.
            </p>
          </div>
          <a href="#derivar" class="efe-svc-panel__footer">
            Ver qué podés derivarnos <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="derivar" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div class="efe-svc-intro-grid" style="grid-template-columns:minmax(0,3fr) minmax(0,2fr)">
        <div data-reveal>
          <div class="efe-eyebrow">01 — Qué podés derivarnos</div>
          <h2 class="efe-h2">Lo técnico lo<br />resolvemos nosotros</h2>
        </div>
        <p class="efe-lede" data-reveal data-delay="1" style="max-width:52ch">
          No competimos con tu agencia: no hacemos estrategia ni redactamos contenido. Tomamos lo que requiere
          desarrollo, servidor y código, y te lo devolvemos listo para que lo presentes como tuyo.
        </p>
      </div>

      <div class="efe-svc-grid" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          derivar.map((item) => (
            <a href={item.servicio.href} data-scroll="tilt" class="efe-svc-card">
              <div class="efe-svc-card__top">
                <span class="efe-svc-card__num">{item.num}</span>
                <span class="efe-svc-card__badge">{item.badge}</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-svc-card__desc">{item.desc}</p>
              <div class="efe-svc-card__foot">{precio(item.servicio)}</div>
            </a>
          ))
        }
        <a href="/contacto/" class="efe-svc-cta">
          <div class="efe-svc-cta__eyebrow">Empecemos por un proyecto</div>
          <h3 class="efe-h3" style="color:#08080A">¿Tenés un cliente<br />con un proyecto?</h3>
          <span class="efe-svc-cta__btn">Contanos tu caso <span>↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section id="trabajo" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div data-reveal>
        <div class="efe-eyebrow">02 — Cómo trabajamos juntos</div>
        <h2 class="efe-h2">Simple de<br />sumar a tu equipo</h2>
      </div>

      <div class="efe-grid efe-grid--3" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          trabajo.map((item) => (
            <div data-scroll="tilt" class="efe-svc-card">
              <div class="efe-svc-card__top">
                <span class="efe-svc-card__num">{item.num}</span>
                <span class="efe-svc-card__badge">↗</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-svc-card__desc">{item.desc}</p>
              <div class="efe-svc-card__foot">{item.nota}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="porque" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container">
      <div data-reveal>
        <div class="efe-eyebrow">03 — Por qué efedigital</div>
        <h2 class="efe-h2">Un proveedor que<br />no te complica</h2>
      </div>

      <div class="efe-grid efe-grid--3" data-stagger style="margin-top:clamp(48px,5.5vw,72px)">
        {
          porque.map((item) => (
            <div data-scroll="tilt" class="efe-svc-card">
              <div class="efe-svc-card__top">
                <span class="efe-svc-card__num">{item.num}</span>
                <span class="efe-svc-card__badge">↗</span>
              </div>
              <h3 class="efe-h3">{item.titulo}</h3>
              <p class="efe-svc-card__desc">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="preguntas" class="efe-section efe-section--border-top" style="position:relative">
    <div class="efe-container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(32px,5vw,80px);align-items:start">
      <div data-reveal>
        <div class="efe-eyebrow">04 — Preguntas</div>
        <h2 style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:clamp(34px,5.4vw,82px);line-height:.9;letter-spacing:-.042em">
          Lo que nos <br />preguntan
        </h2>
        <p style="margin:26px 0 0;max-width:32ch;font-size:16.5px;line-height:1.6;color:#8B8B93;text-wrap:pretty">
          Si te queda alguna duda, escribinos: contestamos nosotros, no un bot.
        </p>
      </div>
      <div data-reveal data-delay="1" style="display:flex;flex-direction:column;border-top:1px solid rgba(255,255,255,.12)">
        {
          faqs.map((f, i) => (
            <div class="efe-faq-item" style="border-bottom:1px solid rgba(255,255,255,.12)">
              <button type="button" class="efe-faq-toggle" aria-expanded="false" data-index={i}>
                <span class="efe-faq-question">{f.pregunta}</span>
                <span class="efe-faq-icon">+</span>
              </button>
              <div class="efe-faq-panel">
                <p style="margin:0;padding:0 0 26px;min-height:0;overflow:hidden;max-width:58ch;font-size:15.5px;line-height:1.66;color:#8B8B93;text-wrap:pretty">
                  {f.respuesta}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .efe-word {
    display: inline-block;
    animation: efe-rise 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .efe-svc-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(300px, 5fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .efe-svc-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .efe-tag {
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a9a9b1;
  }

  .efe-svc-panel {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0d0d10;
  }
  .efe-svc-panel__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b8b93;
  }
  .efe-svc-panel__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4ff3f;
    animation: efe-pulse 2.2s ease-in-out infinite;
  }
  .efe-svc-panel__badge {
    margin-left: auto;
    color: #f5f2ec;
  }
  .efe-svc-panel__row {
    padding: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .efe-svc-panel__title {
    margin: 0;
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: 20px;
    color: #f5f2ec;
  }
  .efe-svc-panel__text {
    margin: 8px 0 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: #8b8b93;
  }
  .efe-svc-panel__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 22px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f5f2ec;
    transition: color 0.22s ease;
  }
  .efe-svc-panel__footer:hover {
    color: #d4ff3f;
  }

  .efe-svc-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }
  @media (max-width: 760px) {
    .efe-svc-intro-grid {
      grid-template-columns: 1fr !important;
    }
  }

  .efe-svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 1.8vw, 24px);
  }
  @media (min-width: 720px) {
    .efe-svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .efe-svc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .efe-svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #f5f2ec;
    text-decoration: none;
    transition: border-color 0.45s ease, background 0.45s ease, box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-svc-card:hover {
    color: #f5f2ec;
    border-color: #d4ff3f;
    background: #121218;
    box-shadow: 10px 10px 0 rgba(212, 255, 63, 0.85);
    translate: -5px -5px;
  }
  .efe-svc-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .efe-svc-card__num {
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
    color: rgba(245, 242, 236, 0.12);
  }
  .efe-svc-card__badge {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 26px;
    padding: 0 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: #8b8b93;
  }
  .efe-svc-card h3 {
    margin-top: 14px;
  }
  .efe-svc-card__desc {
    margin: 12px 0 0;
    padding-bottom: 10px;
    font-size: 14.5px;
    line-height: 1.58;
    color: #c9c9ce;
  }
  .efe-svc-card__foot {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    line-height: 1.5;
    color: #96969b;
  }

  .efe-svc-cta {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 34px);
    background: #d4ff3f;
    text-decoration: none;
    transition: transform 0.18s ease;
  }
  .efe-svc-cta:hover {
    transform: translate(-3px, -3px);
  }
  .efe-svc-cta__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #08080a;
  }
  .efe-svc-cta__eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: #08080a;
  }
  .efe-svc-cta h3 {
    margin-top: 16px;
    font-size: clamp(24px, 3vw, 44px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .efe-svc-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(20px, 2.4vw, 30px);
    padding: 15px 22px;
    background: #08080a;
    color: #f5f2ec;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: flex-start;
  }

  /* Acordeón de preguntas — mismo comportamiento que Faq.astro (componente no
     importado en esta página: cada instancia necesita su propia copia). */
  .efe-faq-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding: 24px 0;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: #f5f2ec;
    font-size: clamp(16px, 1.5vw, 19.5px);
    font-weight: 600;
    line-height: 1.34;
    font-family: var(--font-body);
  }
  .efe-faq-question {
    position: relative;
  }
  .efe-faq-question::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: #d4ff3f;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-faq-toggle:hover .efe-faq-question::after {
    transform: scaleX(1);
  }
  .efe-faq-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #8b8b93;
    font-size: 16px;
    line-height: 1;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease, border-color 0.3s ease;
  }
  .efe-faq-toggle:hover .efe-faq-icon {
    border-color: #d4ff3f;
    color: #d4ff3f;
  }
  .efe-faq-panel {
    display: grid;
    grid-template-rows: minmax(0, 0fr);
    min-height: 0;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
    transition: grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.42s;
  }
  .efe-faq-panel > p {
    min-height: 0;
  }
  .efe-faq-item.is-open .efe-faq-icon {
    transform: rotate(135deg);
    color: #d4ff3f;
    border-color: #d4ff3f;
  }
  .efe-faq-item.is-open .efe-faq-panel {
    grid-template-rows: minmax(0, 1fr);
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".efe-faq-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".efe-faq-item");
      if (!item) return;
      const willOpen = !item.classList.contains("is-open");
      item.parentElement?.querySelectorAll(".efe-faq-item.is-open").forEach((open) => {
        open.classList.remove("is-open");
        open.querySelector(".efe-faq-toggle")?.setAttribute("aria-expanded", "false");
      });
      if (willOpen) {
        item.classList.add("is-open");
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
