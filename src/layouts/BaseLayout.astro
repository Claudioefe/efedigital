---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface FooterCta {
  titleHtml: string;
  subtitle?: string;
  showButton?: boolean;
}

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
  footerCta?: FooterCta;
}

const DEFAULT_OG_IMAGE = "https://efedigital.com.ar/efedigital-social-og.png";

const {
  title,
  description,
  path = "/",
  ogImage = DEFAULT_OG_IMAGE,
  ogType = "website",
  articlePublishedTime,
  schema,
  noindex = false,
  footerCta,
} = Astro.props;

const SITE_URL = "https://efedigital.com.ar";
// Con barra final a propósito: Netlify sirve las rutas como directorio y redirige
// /blog -> /blog/ con un 301. Si el canonical apuntara a la forma sin barra estaría
// señalando una URL que redirige, y Google descarta ese canonical.
const canonicalPath = path.endsWith("/") ? path : `${path}/`;
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();

// Las medidas y el alt solo valen para la imagen por defecto: las portadas de los
// posts tienen otros tamaños (1400x781, 1400x933, 1800x1004) y declararlas mal hace
// que las redes recorten o rechacen la tarjeta.
const isDefaultOgImage = ogImage === DEFAULT_OG_IMAGE;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Fuentes primero y solo las variantes que el sitio realmente renderiza
         (verificado recorriendo el DOM de todas las páginas). El sitio no usa
         itálicas, así que no se piden: antes se bajaban ~30 variantes. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Lora:wght@700&family=Open+Sans:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <meta name="description" content={description} />
    <meta name="google-site-verification" content="LfqRLrcpoNoGyCCiZje1l0RxZ6hacrdW4ZM4doYfh8Y" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {isDefaultOgImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="efedigital — Desarrollo Web, Automatización e Inteligencia Artificial" />
      </>
    )}
    <meta property="og:site_name" content="efedigital" />
    <meta property="og:locale" content="es_AR" />
    {ogType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="author" content="efedigital" />
    <meta name="theme-color" content="#08080A" />

    {
      schema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
        />
      )
    }

    <!-- Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-HY78M19P0F");

      // gtag.js son ~510 KB y en 4G tarda ~2s. Es async, así que no bloquea el
      // renderizado, pero sí le pelea el ancho de banda a las fuentes y al hero.
      // Cargándolo después de load no se pierde nada: las llamadas de arriba
      // quedan en la cola de dataLayer y se procesan cuando el script llega.
      addEventListener(
        "load",
        () => {
          const s = document.createElement("script");
          s.src = "https://www.googletagmanager.com/gtag/js?id=G-HY78M19P0F";
          s.async = true;
          document.head.appendChild(s);
        },
        { once: true }
      );
    </script>

  </head>
  <body>
    <div id="efe-cursor-ring" style="position:fixed;top:0;left:0;z-index:9999;width:34px;height:34px;margin:-17px 0 0 -17px;border:1px solid rgba(245,242,236,.5);pointer-events:none;mix-blend-mode:difference;transition:width .25s ease,height .25s ease,margin .25s ease,background .25s ease;opacity:0"></div>
    <div id="efe-cursor-dot" style="position:fixed;top:0;left:0;z-index:10000;width:5px;height:5px;margin:-2.5px 0 0 -2.5px;background:#D4FF3F;pointer-events:none;opacity:0"></div>

    <a href="#efe-main" class="efe-skip">Ir al contenido</a>

    <div id="efe-page" style="position:relative;z-index:1;background:#08080A;color:#F5F2EC;font-family:'Open Sans',sans-serif">
      <Header />
      <main id="efe-main">
        <slot />
      </main>
    </div>

    <Footer cta={footerCta} />

    <script src="../scripts/site.ts"></script>
    <script src="../scripts/ai-citation-tracker.ts"></script>
  </body>
</html>
