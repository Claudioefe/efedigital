---
const puntos = [
  { titulo: "Marca blanca o partner visible", desc: "Vos elegís cómo nos presentás ante tu cliente." },
  { titulo: "WordPress, mantenimiento y a medida", desc: "Desarrollo, velocidad, SEO técnico y automatización." },
  { titulo: "Precios claros, desde USD 100", desc: "Los mismos de referencia que ves en cada servicio." },
];
---

<section id="agencias" class="efe-section efe-section--border-top">
  <div class="efe-container efe-agencias">
    <div data-reveal>
      <div class="efe-eyebrow">Para agencias</div>
      <h2 class="efe-agencias__title">
        ¿Tenés una agencia? <br />Somos tu equipo técnico
      </h2>
      <p class="efe-agencias__lede">
        Si vendés SEO, marketing o sitios y preferís derivar el desarrollo y el mantenimiento WordPress en vez de
        ampliar el equipo, trabajamos con vos y vos te quedás con el cliente.
      </p>
      <a href="/para-agencias/" class="efe-btn efe-btn--primary" style="margin-top:clamp(24px,3vw,34px)">
        Ver cómo trabajamos juntos <span style="font-size:14px">↗</span>
      </a>
    </div>

    <ul data-reveal data-delay="1" class="efe-agencias__list">
      {
        puntos.map((p) => (
          <li class="efe-agencias__item">
            <span class="efe-agencias__mark" aria-hidden="true">↗</span>
            <span>
              <span class="efe-agencias__item-title">{p.titulo}</span>
              <span class="efe-agencias__item-desc">{p.desc}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .efe-agencias {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  @media (max-width: 860px) {
    .efe-agencias {
      grid-template-columns: 1fr;
    }
  }
  .efe-agencias__title {
    margin: 0;
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: clamp(30px, 3.7vw, 54px);
    line-height: 0.96;
    letter-spacing: -0.04em;
  }
  .efe-agencias__lede {
    margin: 22px 0 0;
    max-width: 50ch;
    font-size: clamp(16px, 1.4vw, 18.5px);
    line-height: 1.6;
    color: #a9a9b1;
    text-wrap: pretty;
  }
  .efe-agencias__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0d0d10;
  }
  .efe-agencias__item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 22px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .efe-agencias__item:last-child {
    border-bottom: 0;
  }
  .efe-agencias__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(212, 255, 63, 0.45);
    color: #d4ff3f;
    font-size: 13px;
  }
  .efe-agencias__item-title {
    display: block;
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: 19px;
    color: #f5f2ec;
  }
  .efe-agencias__item-desc {
    display: block;
    margin-top: 5px;
    font-size: 14px;
    line-height: 1.5;
    color: #8b8b93;
  }
</style>
