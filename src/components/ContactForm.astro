---
import { necesidades } from "../data/home-necesidades";

interface Props {
  eyebrow?: string;
}

const { eyebrow = "Contacto" } = Astro.props;
---

<section
  id="contacto"
  class="efe-section efe-section--border-top"
  style="overflow:hidden;min-height:calc(100vh - 66px);display:flex;align-items:center"
>
  <div
    data-parallax="0.18"
    style="position:absolute;top:-24%;left:-12%;width:min(46vw,620px);height:min(46vw,620px);border-radius:50%;background:radial-gradient(closest-side,rgba(212,255,63,.16),transparent 72%);filter:blur(46px);pointer-events:none"
  >
  </div>
  <div
    style="position:relative;width:100%;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:clamp(32px,5vw,72px);align-items:start"
  >
    <div data-reveal>
      <div class="efe-eyebrow">{eyebrow}</div>
      <h1 style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:clamp(40px,7vw,112px);line-height:.86;letter-spacing:-.048em">
        Hablemos<br />de tu<br />proyecto
      </h1>
      <p style="margin:26px 0 0;max-width:38ch;font-size:16.5px;line-height:1.6;color:#A9A9B1;text-wrap:pretty">
        Contanos qué necesitás y te armamos una propuesta personalizada. Sin compromisos, sin letra chica.
      </p>
      <div style="display:flex;flex-direction:column;gap:16px;margin-top:32px">
        <a href="mailto:claudioefe@icloud.com" class="efe-contact-link">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="1.5" stroke="#D4FF3F" stroke-width="1.6" />
            <path d="M4 6.5l8 6.2 8-6.2" stroke="#D4FF3F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          claudioefe@icloud.com
        </a>
        <a href="https://wa.me/5493764279444" target="_blank" rel="noopener noreferrer" class="efe-contact-link">
          <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="#D4FF3F"
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            />
          </svg>
          +54 9 376 4279444
        </a>
      </div>
    </div>
    <form
      name="contacto"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      id="efe-contact-form"
      data-reveal
      data-delay="1"
      style="display:flex;flex-direction:column;gap:18px;padding:clamp(26px,3vw,42px);background:#0F0F13;border:1px solid rgba(255,255,255,.12)"
    >
      <input type="hidden" name="form-name" value="contacto" />
      <p style="display:none">
        <label>No completar si sos humano: <input name="bot-field" /></label>
      </p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:18px">
        <label class="efe-field-label">
          Nombre
          <input type="text" name="nombre" placeholder="Cómo te llamás" required class="efe-input" />
        </label>
        <label class="efe-field-label">
          Email
          <input type="email" name="email" placeholder="tu@empresa.com" required class="efe-input" />
        </label>
      </div>
      <div style="display:flex;flex-direction:column;gap:12px">
        <span class="efe-field-caption">Qué necesitás</span>
        <div style="display:flex;flex-wrap:wrap;gap:9px" id="efe-necesidades">
          {
            necesidades.map((label, i) => (
              <button type="button" class="efe-chip" class:list={{ "is-active": i === 0 }} data-label={label}>
                {label}
              </button>
            ))
          }
        </div>
        <input type="hidden" name="necesidades" id="efe-necesidades-input" value={necesidades[0]} />
      </div>
      <label class="efe-field-label">
        Contanos un poco
        <textarea
          rows="4"
          name="mensaje"
          placeholder="Hoy cargamos los pedidos a mano en una planilla y se nos escapan cosas…"
          class="efe-input"></textarea>
      </label>
      <button type="submit" id="efe-submit-btn" class="efe-btn efe-btn--primary" style="justify-content:center;margin:8px 8px 0 0">
        <span id="efe-submit-text">Enviar y pedir presupuesto</span> <span style="font-size:14px">↗</span>
      </button>
      <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:#9A9AA2"
        >Sin compromiso · Respuesta en 24 h hábiles</span
      >
    </form>
  </div>
</section>

<style>
  .efe-field-label {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #8b8b93;
  }
  .efe-field-caption {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #8b8b93;
  }
  .efe-input {
    padding: 15px;
    background: #141419;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #f5f2ec;
    font-size: 15px;
    line-height: 1.55;
    outline: none;
    transition: border-color 0.22s ease;
  }
  .efe-input:focus {
    border-color: #d4ff3f;
  }
  .efe-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #f5f2ec;
    font-family: var(--font-mono);
    font-size: 13.5px;
    letter-spacing: 0.03em;
  }
  .efe-contact-link:hover {
    color: #d4ff3f;
  }
  .efe-chip {
    padding: 11px 16px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition: all 0.2s ease;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #a9a9b1;
  }
  .efe-chip.is-active {
    background: #d4ff3f;
    border-color: #d4ff3f;
    color: #08080a;
  }
</style>

<script>
  declare global {
    interface Window {
      gtag?: (...args: unknown[]) => void;
    }
  }

  const form = document.getElementById("efe-contact-form") as HTMLFormElement | null;
  const chips = document.querySelectorAll<HTMLButtonElement>("#efe-necesidades .efe-chip");
  const hiddenInput = document.getElementById("efe-necesidades-input") as HTMLInputElement | null;
  const submitBtn = document.getElementById("efe-submit-btn");
  const submitText = document.getElementById("efe-submit-text");

  const selected = new Set<string>();
  // Estado inicial, para poder volver a él después de un envío: form.reset() devuelve
  // el input oculto a su default del HTML pero no toca el Set ni las clases is-active,
  // así que sin esto el siguiente envío manda algo distinto de lo que se ve marcado.
  const iniciales = Array.from(chips)
    .filter((c) => c.classList.contains("is-active"))
    .map((c) => c.dataset.label || "");

  const sincronizarChips = () => {
    chips.forEach((chip) => {
      chip.classList.toggle("is-active", selected.has(chip.dataset.label || ""));
    });
    if (hiddenInput) hiddenInput.value = Array.from(selected).join(", ");
  };

  const resetearChips = () => {
    selected.clear();
    iniciales.forEach((l) => selected.add(l));
    sincronizarChips();
  };

  chips.forEach((chip) => {
    if (chip.classList.contains("is-active")) selected.add(chip.dataset.label || "");
    chip.addEventListener("click", () => {
      const label = chip.dataset.label || "";
      if (selected.has(label)) {
        selected.delete(label);
        chip.classList.remove("is-active");
      } else {
        selected.add(label);
        chip.classList.add("is-active");
      }
      if (hiddenInput) hiddenInput.value = Array.from(selected).join(", ");
    });
  });

  const ETIQUETA_BOTON = "Enviar y pedir presupuesto";
  let volverAEtiqueta: ReturnType<typeof setTimeout> | undefined;

  const mensajeTemporal = (texto: string) => {
    if (submitText) submitText.textContent = texto;
    // Sin el clear, un segundo envío dentro de los 5s deja que el timeout viejo
    // borre el mensaje nuevo al instante.
    clearTimeout(volverAEtiqueta);
    volverAEtiqueta = setTimeout(() => {
      if (submitText) submitText.textContent = ETIQUETA_BOTON;
    }, 5000);
  };

  let enviando = false;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || enviando) return;
    enviando = true;
    submitBtn?.setAttribute("disabled", "true");
    if (submitText) submitText.textContent = "Enviando…";
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
      const response = await fetch(form.getAttribute("action") || window.location.pathname, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body,
      });
      if (!response.ok) throw new Error("submit failed");
      form.reset();
      resetearChips();
      mensajeTemporal("¡Gracias! Te escribimos");
      if (typeof window.gtag === "function") {
        window.gtag("event", "conversion", { send_to: "AW-18451433875/rbaXCOyP4_ccEJOTqt5E" });
      }
    } catch {
      mensajeTemporal("Hubo un error, reintentá");
    } finally {
      enviando = false;
      submitBtn?.removeAttribute("disabled");
    }
  });
</script>
