---
interface Props {
  src?: string;
  alt: string;
  label: string;
  priority?: boolean;
}

const { src, alt, label, priority = false } = Astro.props;
---

{
  src ? (
    <img
      src={src}
      alt={alt}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding={priority ? "sync" : "async"}
      style="width:100%;height:100%;object-fit:cover;object-position:top"
    />
  ) : (
    <div
      style="width:100%;height:100%;display:grid;place-items:center;padding:16px;text-align:center;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#8B8B93"
    >
      {label}
    </div>
  )
}
