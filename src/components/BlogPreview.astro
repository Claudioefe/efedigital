---
import BlogImage from "./BlogImage.astro";
import { getPublishedPosts, formatMonth } from "../utils/blog";

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);
---

<section id="blog" class="efe-section efe-section--border-top">
  <div class="efe-container">
    <div
      style="display:flex;flex-wrap:wrap;gap:24px;align-items:end;justify-content:space-between;margin-bottom:clamp(36px,4.5vw,60px)"
    >
      <div>
        <div class="efe-eyebrow" data-reveal>04 — Blog</div>
        <h2 class="efe-h2" data-reveal data-delay="1">Lo que vamos<br />aprendiendo</h2>
      </div>
      <a
        href="/blog"
        data-reveal
        data-delay="2"
        class="efe-ver-todas"
        style="display:flex;align-items:center;gap:10px;padding:17px 28px;color:#F5F2EC;font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.13em;text-transform:uppercase"
        >Ver todas <span>↗</span></a
      >
    </div>
    <div data-stagger style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(16px,2vw,26px)">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            data-scroll="tilt"
            style="display:flex;flex-direction:column;background:#0F0F13;overflow:hidden;text-decoration:none;color:inherit"
          >
            <div style="position:relative;height:220px;background:#131318;border-bottom:1px solid rgba(255,255,255,.1);overflow:hidden">
              <BlogImage src={post.data.imagen} alt={post.data.titulo} label={post.data.slotLabel} />
            </div>
            <div style="display:flex;flex-direction:column;gap:14px;padding:26px;flex:1">
              <div style="display:flex;gap:14px;font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:#9A9AA2">
                <span style="color:#D4FF3F">{post.data.categoria}</span>
                <span>{formatMonth(post.data.fecha)}</span>
              </div>
              <h3 style="margin:0;font-size:20.5px;font-weight:700;line-height:1.26;letter-spacing:-.015em;color:#F5F2EC;text-wrap:pretty">
                {post.data.titulo}
              </h3>
              <p style="margin:0;font-size:15px;line-height:1.6;color:#8B8B93;text-wrap:pretty">{post.data.bajada}</p>
              <span style="margin-top:auto;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:#D4FF3F">
                Leer nota ↗
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  #blog a[data-scroll] {
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.45s ease, box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1), translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #blog a[data-scroll]:hover {
    border-color: #d4ff3f;
    box-shadow: 9px 9px 0 rgba(212, 255, 63, 0.85);
    translate: -4px -4px;
  }
  .efe-ver-todas {
    border: 1px solid rgba(245, 242, 236, 0.3);
    box-shadow: 7px 7px 0 rgba(212, 255, 63, 0.85);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .efe-ver-todas:hover {
    transform: translate(4px, 4px);
    box-shadow: 3px 3px 0 rgba(212, 255, 63, 0.85);
  }
</style>
