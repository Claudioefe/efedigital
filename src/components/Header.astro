---
import { nav } from "../data/nav";
import LogoAnimado from "./LogoAnimado.astro";

// En el build las rutas llegan con barra final (/servicios/mantenimiento/) y en dev sin
// ella: se normaliza para que la comparación funcione igual en los dos.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const sinBarra = (u: string) => u.replace(/\/+$/, "") || "/";
const activosPorPrefijo = ["/blog", "/para-agencias"];
const isActive = (href: string) => activosPorPrefijo.includes(sinBarra(href)) && pathname.startsWith(sinBarra(href));

// Copy propia del menú, más corta que la de /servicios o la home a propósito
// (es un desplegable, no una página) — separada así no se rompe si esos datos cambian.
// Cada servicio lleva su copy "destacada" (para cuando es la card grande) además
// de la corta (para cuando aparece en la lista chica). Si estás parado en una de
// estas páginas, esa es la destacada; si no, cae en desarrollo-web por default.
const servicios = [
  {
    href: "/servicios/desarrollo-web/",
    titulo: "Desarrollo web & e-commerce",
    desc: "WordPress con temas propios en bloques, catálogo y checkout.",
    descripcionDestacada:
      "Sitios y tiendas online hechas para vender: catálogo, checkout y pagos que funcionan bien en cualquier dispositivo.",
    tags: ["WordPress", "WooCommerce", "E-commerce"],
    cta: "Empezar mi proyecto",
  },
  {
    href: "/servicios/automatizaciones/",
    titulo: "Automatización con n8n",
    desc: "Flujos que conectan tus APIs y te sacan tareas manuales.",
    descripcionDestacada:
      "Flujos a medida que conectan tus herramientas y sacan las tareas repetitivas de encima, 24 horas al día.",
    tags: ["n8n", "APIs", "IA"],
    cta: "Empezar un proyecto",
  },
  {
    href: "/servicios/auditoria-tecnica/",
    titulo: "Auditoría técnica de SEO, GEO y AEO",
    desc: "Rastreabilidad, indexación y legibilidad para los motores de IA.",
    descripcionDestacada:
      "Rastreabilidad, indexación, datos estructurados y legibilidad para los motores de IA. Informe priorizado por impacto.",
    tags: ["Schema", "Indexación", "AEO"],
    cta: "Pedir la auditoría",
  },
  {
    href: "/servicios/mantenimiento/",
    titulo: "Mantenimiento & soporte",
    desc: "Actualizaciones, backups, monitoreo y seguridad, mes a mes.",
    descripcionDestacada:
      "Actualizaciones, backups, monitoreo y seguridad para que tu sitio siga andando sin que tengas que pensarlo vos.",
    tags: ["Backups", "Seguridad", "Monitoreo"],
    cta: "Armar mi plan",
  },
  {
    href: "/servicios/optimizacion/",
    titulo: "Optimización",
    desc: "Velocidad, caché a medida y Core Web Vitals en verde.",
    descripcionDestacada:
      "Caché a medida, limpieza de código innecesario y ajustes de servidor, medidos con Core Web Vitals.",
    tags: ["PageSpeed", "Caché", "Cloudflare"],
    cta: "Medir mi sitio",
  },
];

const destacado: (typeof servicios)[number] =
  servicios.find((s) => sinBarra(s.href) === pathname) ?? servicios[0];

const serviciosMenu = {
  destacado,
  resto: servicios
    .filter((s) => s.href !== destacado.href)
    .map((s, i) => ({ ...s, num: String(i + 1).padStart(2, "0") })),
};
---

<header
  style="position:sticky;top:0;z-index:80;background:#0C0C0F;border-bottom:1px solid rgba(255,255,255,.1)"
>
  <div
    id="efe-header-row"
    style="display:flex;align-items:stretch;justify-content:space-between;gap:12px;max-width:1440px;margin:0 auto;padding-left:clamp(16px,3vw,40px)"
  >
    <a href="/" class="efe-logo" aria-label="efedigital — Inicio" style="display:flex;align-items:center;color:#F5F2EC">
      <LogoAnimado uid="hdr" style="height:30px" />
    </a>
    <nav aria-label="Principal" style="display:flex;align-items:stretch;min-width:0;margin-left:auto">
      <span id="efe-nav-links">
        {
          nav.map((n) =>
            n.label === "Servicios" ? (
              <div class="efe-nav-item">
                <a
                  href={n.href}
                  class={`efe-nav-link${isActive(n.href) ? " is-active" : ""}`}
                  style="display:flex;align-items:center;height:100%;padding:0 clamp(12px,1.6vw,24px);border-left:1px solid rgba(255,255,255,.1);font-family:'Chakra Petch',sans-serif;font-weight:500;font-size:13.5px;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap"
                >
                  <span class="efe-nav-link__label">{n.label}</span>
                  <svg class="efe-nav-link__chevron" width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true">
                    <path d="M1 1L4.5 4.5L8 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                <div class="efe-servicios-menu">
                  <div class="efe-servicios-menu__inner">
                    <a href={serviciosMenu.destacado.href} class="efe-servicios-menu__feature">
                      <span class="efe-servicios-menu__feature-eyebrow">
                        {pathname === sinBarra(serviciosMenu.destacado.href) ? "Estás viendo esto" : "Servicio más pedido"}{" "}
                        <span>↗</span>
                      </span>
                      <p class="efe-servicios-menu__title">{serviciosMenu.destacado.titulo}</p>
                      <p>{serviciosMenu.destacado.descripcionDestacada}</p>
                      <div class="efe-servicios-menu__tags">
                        {serviciosMenu.destacado.tags.map((t) => (
                          <span>{t}</span>
                        ))}
                      </div>
                    </a>
                    <div class="efe-servicios-menu__list">
                      {serviciosMenu.resto.map((s) => (
                        <a href={s.href} class="efe-servicios-menu__item">
                          <span class="efe-servicios-menu__num">{s.num}</span>
                          <span>
                            <span class="efe-servicios-menu__item-title">{s.titulo}</span>
                            <span class="efe-servicios-menu__item-desc">{s.desc}</span>
                          </span>
                        </a>
                      ))}
                      <a href="/servicios/" class="efe-servicios-menu__all">
                        Ver todos los servicios <span>↗</span>
                      </a>
                    </div>
                  </div>
                  <div class="efe-servicios-menu__foot">
                    <span class="efe-servicios-menu__foot-label">
                      <span class="efe-servicios-menu__foot-dot"></span> Charla inicial de 30 min sin costo
                    </span>
                    <a href="/contacto/" class="efe-text-link">
                      {serviciosMenu.destacado.cta} <span>↗</span>
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={n.href}
                class={`efe-nav-link${isActive(n.href) ? " is-active" : ""}`}
                style="display:flex;align-items:center;padding:0 clamp(12px,1.6vw,24px);border-left:1px solid rgba(255,255,255,.1);font-family:'Chakra Petch',sans-serif;font-weight:500;font-size:13.5px;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap"
              >
                <span class="efe-nav-link__label">{n.label}</span>
              </a>
            )
          )
        }
      </span>
      <a
        id="efe-header-cta"
        href="/contacto/"
        style="align-items:center;gap:9px;padding:20px clamp(16px,2vw,28px);color:#08080A;font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:500;letter-spacing:.13em;text-transform:uppercase;white-space:nowrap"
      >
        Empecemos <span>↗</span>
      </a>
      <a
        href="https://www.instagram.com/efedigital/"
        target="_blank"
        rel="noopener noreferrer"
        class="efe-header-icon"
        aria-label="Instagram"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="2" width="20" height="20" rx="5"></rect>
          <circle cx="12" cy="12" r="4.2"></circle>
          <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <a
        href="https://wa.me/5493764279444"
        target="_blank"
        rel="noopener noreferrer"
        class="efe-header-icon"
        aria-label="WhatsApp"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
          ></path>
        </svg>
      </a>
      <button
        id="efe-menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="efe-mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>
  <div style="height:2px;background:rgba(255,255,255,.06)">
    <div id="efe-progress" style="height:100%;width:0%;background:#D4FF3F"></div>
  </div>
</header>

<div id="efe-mobile-menu" aria-hidden="true">
  <nav aria-label="Menú">
    {
      nav.map((n) => (
        <a href={n.href} class="efe-mobile-link">
          {n.label}
        </a>
      ))
    }
  </nav>
  <a href="/contacto/" class="efe-btn efe-btn--primary" style="align-self:flex-start">
    Empecemos <span style="font-size:14px">↗</span>
  </a>
</div>

<style>
  #efe-nav-links {
    display: flex;
    align-items: stretch;
    min-width: 0;
  }
  .efe-logo {
    flex: none;
    padding-right: clamp(12px, 2vw, 24px);
  }

  .efe-nav-link {
    position: relative;
    overflow: hidden;
    color: #f5f2ec;
    background: transparent;
    transition: color 0.3s ease;
  }
  .efe-nav-link.is-active {
    color: #d4ff3f;
    background: rgba(212, 255, 63, 0.1);
  }
  .efe-nav-link__label {
    position: relative;
    z-index: 1;
  }
  .efe-nav-link__chevron {
    position: relative;
    z-index: 1;
    margin-left: 7px;
    flex: none;
    color: currentColor;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .efe-nav-item:hover .efe-nav-link__chevron,
  .efe-nav-item:focus-within .efe-nav-link__chevron {
    transform: rotate(180deg);
  }
  .efe-nav-link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #d4ff3f;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .efe-nav-link:hover::before {
    transform: translateY(0);
  }
  .efe-nav-link:hover {
    color: #08080a;
  }

  .efe-nav-item {
    position: relative;
    display: flex;
  }
  .efe-servicios-menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 90;
    width: min(720px, 92vw);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.12);
    opacity: 0;
    visibility: hidden;
    translate: 0 -6px;
    transition: opacity 0.22s ease, translate 0.22s ease, visibility 0.22s;
  }
  .efe-nav-item:hover .efe-servicios-menu,
  .efe-nav-item:focus-within .efe-servicios-menu {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }
  .efe-servicios-menu__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
  }
  .efe-servicios-menu__feature {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px 24px;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(212, 255, 63, 0.06);
    color: #f5f2ec;
    transition: background 0.22s ease, border-color 0.22s ease;
  }
  .efe-servicios-menu__feature:hover {
    background: rgba(212, 255, 63, 0.11);
    border-right-color: rgba(212, 255, 63, 0.3);
  }
  .efe-servicios-menu__feature-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d4ff3f;
  }
  .efe-servicios-menu__title {
    margin: 0;
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: 19px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #f5f2ec;
  }
  .efe-servicios-menu__feature p {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: #a9a9b1;
  }
  .efe-servicios-menu__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
  .efe-servicios-menu__tags span {
    padding: 5px 10px;
    border: 1px solid rgba(212, 255, 63, 0.35);
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #d4ff3f;
  }
  .efe-servicios-menu__list {
    display: flex;
    flex-direction: column;
    padding: 10px 12px;
  }
  .efe-servicios-menu__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 12px;
    color: inherit;
    transition: background 0.18s ease;
  }
  .efe-servicios-menu__item:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  .efe-servicios-menu__num {
    flex: none;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
    color: #d4ff3f;
    padding-top: 2px;
  }
  .efe-servicios-menu__item-title {
    display: block;
    font-family: "Chakra Petch", sans-serif;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #f5f2ec;
  }
  .efe-servicios-menu__item-desc {
    display: block;
    margin-top: 4px;
    font-size: 12.5px;
    line-height: 1.45;
    color: #8b8b93;
  }
  .efe-servicios-menu__all {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    padding: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d4ff3f;
  }
  .efe-servicios-menu__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .efe-servicios-menu__foot-label {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8b8b93;
  }
  .efe-servicios-menu__foot-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4ff3f;
    animation: efe-pulse 2.2s ease-in-out infinite;
  }
  @media (max-width: 1000px) {
    .efe-servicios-menu__inner {
      grid-template-columns: 1fr;
    }
    .efe-servicios-menu__feature {
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  #efe-header-cta {
    display: flex;
    background: #d4ff3f;
    transition: background 0.22s ease;
  }
  #efe-header-cta span {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #efe-header-cta:hover {
    background: #f5f2ec;
  }
  #efe-header-cta:hover span {
    transform: translateX(4px);
  }

  .efe-header-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    flex: none;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    /* color acá, no inline: un color puesto vía style="" nunca lo puede pisar
       el :hover de abajo, sea cual sea la especificidad de la regla. */
    color: #d4ff3f;
    transition: background 0.22s ease, color 0.22s ease;
  }
  .efe-header-icon:hover {
    background: #f5f2ec;
    color: #08080a;
  }
  /* Cierra la fila con una línea a la derecha, pero solo en desktop: en mobile
     el toggle de hamburguesa queda visible justo después y ya trae la suya. */
  @media (min-width: 761px) {
    .efe-header-icon:last-of-type {
      border-right: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  #efe-menu-toggle {
    display: none;
    flex: none;
    width: 52px;
    align-items: center;
    justify-content: center;
    gap: 5px;
    flex-direction: column;
    background: none;
    border: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
    padding: 0;
  }
  #efe-menu-toggle span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: #f5f2ec;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }
  html[data-efe-menu-open] #efe-menu-toggle span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  html[data-efe-menu-open] #efe-menu-toggle span:nth-child(2) {
    opacity: 0;
  }
  html[data-efe-menu-open] #efe-menu-toggle span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  #efe-mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 79;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(28px, 6vw, 44px) clamp(20px, 5vw, 36px);
    background: #0c0c0f;
    transform: translateX(100%);
    /* visibility, además de la animación, saca los links del orden de tabulación
       mientras el menú está cerrado. */
    visibility: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
  }
  html[data-efe-menu-open] #efe-mobile-menu {
    transform: translateX(0);
    visibility: visible;
  }
  #efe-mobile-menu nav {
    display: flex;
    flex-direction: column;
  }
  .efe-mobile-link {
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: #f5f2ec;
    font-family: "Chakra Petch", sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 7vw, 32px);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .efe-mobile-link:hover {
    color: #d4ff3f;
  }

  @media (max-width: 760px) {
    #efe-nav-links {
      display: none;
    }
    #efe-header-cta {
      display: none;
    }
    #efe-header-row {
      padding-left: 20px !important;
      padding-right: 20px;
      padding-top: 20px;
      padding-bottom: 20px;
    }
    #efe-menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById("efe-menu-toggle");
  const menu = document.getElementById("efe-mobile-menu");
  const header = document.querySelector("header");

  const syncMenuOffset = () => {
    if (!header || !menu) return;
    menu.style.paddingTop = `${header.offsetHeight + 24}px`;
  };
  syncMenuOffset();
  window.addEventListener("resize", syncMenuOffset);
  if (document.fonts) {
    document.fonts.ready.then(syncMenuOffset);
  }

  const logoLink = document.querySelector<HTMLAnchorElement>(".efe-logo");
  const logoSvg = logoLink?.querySelector<SVGSVGElement>(".efe-logoanim");
  if (logoLink && logoSvg) {
    // La secuencia completa dura ~1.66s; ignoramos hovers mientras corre.
    let lastRun = performance.now();
    logoLink.addEventListener("mouseenter", () => {
      const now = performance.now();
      if (now - lastRun < 1700) return;
      lastRun = now;
      logoSvg.removeAttribute("data-run");
      void logoSvg.getBoundingClientRect();
      logoSvg.setAttribute("data-run", "1");
    });
  }

  const setOpen = (open: boolean) => {
    document.documentElement.toggleAttribute("data-efe-menu-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    menu?.setAttribute("aria-hidden", String(!open));
    document.body.style.overflow = open ? "hidden" : "";
  };

  toggle?.addEventListener("click", () => {
    setOpen(!document.documentElement.hasAttribute("data-efe-menu-open"));
  });

  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 760) setOpen(false);
  });
</script>
