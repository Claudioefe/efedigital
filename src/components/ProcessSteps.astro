---
import { pasos } from "../data/home-proceso";
---

<section id="proceso" style="position:relative;z-index:1;height:360vh;border-top:1px solid rgba(255,255,255,.1)">
  <div style="position:sticky;top:66px;height:calc(100vh - 66px);overflow:hidden">
    <div style="position:absolute;inset:0;display:flex;align-items:center;padding:clamp(24px,4vw,64px) clamp(18px,3.5vw,52px)">
      <div
        style="position:relative;width:100%;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(20px,3vw,44px)"
      >
        <h2 class="efe-eyebrow" style="margin:0;font-weight:inherit">02 — Cómo trabajamos</h2>
        <div style="display:grid;align-items:center">
          {
            pasos.map((p) => (
              <div
                data-paso
                style="grid-area:1/1;display:flex;flex-direction:column;justify-content:center;gap:clamp(14px,2vw,24px);opacity:0;translate:0 40px;transition:opacity .5s ease,translate .6s cubic-bezier(.16,1,.3,1)"
              >
                <div style="display:flex;align-items:flex-start;gap:clamp(16px,2.4vw,36px)">
                  <span style="font-family:'Lora',serif;font-weight:700;font-size:clamp(64px,13vw,190px);line-height:.82;letter-spacing:-.05em;color:transparent;-webkit-text-stroke:1.5px #D4FF3F">
                    {p.num}
                  </span>
                  <div style="display:flex;flex-direction:column;gap:clamp(12px,1.6vw,20px);padding-top:clamp(6px,1vw,18px)">
                    <h3 style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:clamp(28px,4.6vw,72px);line-height:.92;letter-spacing:-.04em;max-width:22ch">
                      {p.titulo}
                    </h3>
                    <p style="margin:0;max-width:44ch;font-size:clamp(16px,1.5vw,21px);line-height:1.55;color:#F5F2EC;text-wrap:pretty">
                      {p.desc}
                    </p>
                    <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8B8B93">
                      {p.plazo}
                    </span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <div style="display:flex;gap:10px;align-items:center">
          {
            pasos.map(() => (
              <div data-paso-dot style="position:relative;flex:1 1 0;height:2px;background:rgba(255,255,255,.14);overflow:hidden">
                <span data-paso-fill style="position:absolute;left:0;top:0;bottom:0;width:0%;background:#D4FF3F" />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
