---
import { homeServicios } from "../data/home-servicios";
---

<section id="servicios" class="efe-section">
  <div class="efe-container">
    <div style="display:flex;flex-direction:column;gap:clamp(20px,2vw,28px);margin-bottom:clamp(40px,5vw,72px)">
      <div>
        <div class="efe-eyebrow" data-reveal>01 — Servicios</div>
        <h2 class="efe-h2" data-reveal data-delay="1">En qué te<br />podemos ayudar</h2>
      </div>
    </div>

    <div class="efe-grid--3" data-stagger data-sync>
      {
        homeServicios.map((s) => (
          <article
            data-scroll="tilt"
            data-spotlight
            class="efe-card"
            style="min-height:300px"
          >
            <div class="efe-card__glow" data-glow />
            <div style="position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:16px">
              <span style="font-family:'Lora',serif;font-weight:700;font-size:clamp(38px,4vw,60px);line-height:.9;letter-spacing:-.05em;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.22)">
                {s.num}
              </span>
              <span style="display:grid;place-items:center;width:38px;height:38px;border:1px solid rgba(255,255,255,.14);font-size:14px;color:#8B8B93">
                ↗
              </span>
            </div>
            <h3 class="efe-h3" style="position:relative">{s.titulo}</h3>
            <p style="position:relative;margin:0;font-size:18.5px;line-height:1.55;color:#F5F2EC;text-wrap:pretty">
              {s.desc}
            </p>
            {s.nota && (
              <p style="position:relative;margin:auto 0 0;padding-top:16px;border-top:1px solid rgba(255,255,255,.12);font-family:'JetBrains Mono',monospace;font-size:11.5px;line-height:1.5;letter-spacing:.02em;color:#8B8B93;text-wrap:pretty">
                {s.nota}
              </p>
            )}
          </article>
        ))
      }
      <article
        id="efe-cta-servicios"
        class="efe-cta-span"
        data-reveal
        style="position:relative;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:clamp(24px,3vw,48px);padding:clamp(28px,3vw,48px);min-height:220px;background:#D4FF3F;color:#08080A;overflow:hidden"
      >
        <div
          style="position:absolute;top:-70px;right:6%;width:260px;height:260px;border-radius:50%;border:1px solid rgba(8,8,10,.22);animation:efe-spin-slow 22s linear infinite"
        >
        </div>
        <div style="position:relative;display:flex;flex-direction:column;gap:16px;max-width:46ch">
          <span style="font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase"
            >¿Y si es otra cosa?</span
          >
          <h3
            style="margin:0;font-family:'Lora',serif;font-weight:700;font-size:clamp(24px,3vw,44px);line-height:1;letter-spacing:-.03em"
          >
            Contanos el problema y te decimos si podemos
          </h3>
        </div>
        <a
          href="/contacto"
          style="position:relative;display:flex;align-items:center;gap:10px;padding:18px 30px;background:#08080A;color:#F5F2EC;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase"
        >
          Escribinos <span>↗</span>
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  #efe-cta-servicios a {
    border: 1px solid #08080a;
    box-shadow: 7px 7px 0 rgba(8, 8, 10, 0.28);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  #efe-cta-servicios a:hover {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0 rgba(8, 8, 10, 0.28);
  }
</style>
