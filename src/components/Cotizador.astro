</style>

<script>
  import { SERVICIOS, calcular, type Respuestas, type Resultado } from "../data/cotizador/precios";
  import { WHATSAPP, wa } from "../data/cotizador/contacto";
  import { PEDIR_EMAIL } from "../data/cotizador/config";

  declare global {
    interface Window {
      gtag?: (...args: unknown[]) => void;
    }
  }

  const app = document.getElementById("cz-app") as HTMLElement | null;
  if (app) iniciar(app);

  function iniciar(app: HTMLElement) {
    const $$ = <T extends Element>(sel: string, root: ParentNode = app) => Array.from(root.querySelectorAll<T>(sel));
    const $ = <T extends Element>(sel: string, root: ParentNode = app) => root.querySelector<T>(sel);

    type Paso = "1" | "2" | "3" | "auto" | "resultado";
    const TITULOS: Record<string, string> = { "1": "¿Qué necesitás?", "2": "Contanos un poco más", "3": "Tu estimación" };
    const usd = (n: number) => new Intl.NumberFormat("es-AR").format(n);
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const esLocal = ["localhost", "127.0.0.1", "[::1]"].includes(location.hostname);

    const tituloServicio = (id: string) => SERVICIOS.find((s) => s.id === id)?.titulo ?? id;

    const seleccion = (): string[] => {
      const marcados = new Set($$<HTMLInputElement>('input[name="srv"]:checked').map((i) => i.value));
      return SERVICIOS.map((s) => s.id).filter((id) => marcados.has(id));
    };

    const leerRespuestas = (sel: string[]): Respuestas => {
      const out: Respuestas = {};
      for (const id of sel) {
        const srv = SERVICIOS.find((s) => s.id === id);
        if (!srv) continue;
        const r: Respuestas[string] = {};
        for (const q of srv.preguntas) {
          const nombre = `${id}.${q.id}`;
          if (q.tipo === "numero") {
            r[q.id] = Number($<HTMLInputElement>(`input[name="${nombre}"]`)?.value) || 0;
          } else if (q.tipo === "una") {
            r[q.id] = $<HTMLInputElement>(`input[name="${nombre}"]:checked`)?.value ?? "";
          } else {
            r[q.id] = $$<HTMLInputElement>(`input[name="${nombre}"]:checked`).map((i) => i.value);
          }
          const n = $<HTMLInputElement>(`input[name="${nombre}__n"]`);
          if (n) r[`${q.id}__n`] = Number(n.value) || 0;
        }
        out[id] = r;
      }
      return out;
    };

    // ---------- estado visual ----------
    // Mantenimiento: las tareas marcadas estiman horas al mes; los planes que no alcanzan se
    // deshabilitan y se recomienda el más chico que cubre.
    const aplicarRecomendacion = () => {
      const fs = $<HTMLElement>('fieldset[data-servicio="mantenimiento"]');
      if (!fs) return;
      const est = $$<HTMLInputElement>("input[data-horasmes]:checked", fs).reduce((a, i) => a + Number(i.dataset.horasmes || 0), 0);
      const planes = $$<HTMLInputElement>("input[data-cap]", fs);
      if (!planes.length) return;
      const rec = (est > 0 && planes.find((i) => Number(i.dataset.cap) >= est)) || planes[0];
      const recIdx = planes.indexOf(rec);
      planes.forEach((i, idx) => {
        i.disabled = idx < recIdx;
        i.closest(".cz-opt")?.classList.toggle("is-corto", idx < recIdx);
      });
      if (!planes.some((i) => i.checked && !i.disabled)) rec.checked = true;
      const n = fs.querySelector<HTMLInputElement>("input[data-abierto]");
      if (n) {
        const minimo = Math.max(Number(n.defaultValue) - 1, Math.ceil(est));
        n.min = String(minimo);
        if (Number(n.value) < minimo) n.value = String(minimo);
      }
      const aviso = fs.querySelector<HTMLElement>("[data-recom]");
      if (aviso) {
        const nombre = rec.closest(".cz-opt")?.querySelector(".cz-opt__label")?.textContent?.trim() ?? "";
        aviso.hidden = est <= 0;
        aviso.textContent = `Con lo que marcaste estimamos unas ${est} horas al mes. Te recomendamos el plan «${nombre}»; los que quedan cortos están deshabilitados.`;
      }
    };

    const sincronizar = () => {
      aplicarRecomendacion();
      $$<HTMLInputElement>('.cz-card input[type="radio"]').forEach((i) =>
        i.closest(".cz-card")?.classList.toggle("is-on", i.checked)
      );
      $$<HTMLInputElement>(".cz-opt > input").forEach((i) => {
        i.closest(".cz-opt")?.classList.toggle("is-on", i.checked);
        const n = i.closest(".cz-opt")?.querySelector<HTMLInputElement>("input[data-abierto]");
        if (n) n.disabled = !i.checked;
      });
      const err1 = $<HTMLElement>("#cz-error-1");
      if (err1 && seleccion().length) err1.hidden = true;
      renderResumen();
    };

    const renderResumen = () => {
      const cont = $("#cz-resumen");
      if (!cont) return;
      const sel = seleccion();
      if (!sel.length) {
        cont.innerHTML = '<p class="cz-side__vacio">Todavía no elegiste nada.</p>';
        return;
      }
      cont.innerHTML = "";
      for (const id of sel) {
        const srv = SERVICIOS.find((s) => s.id === id)!;
        const item = document.createElement("div");
        const t = document.createElement("p");
        t.className = "cz-res-item__t";
        t.textContent = srv.titulo;
        item.append(t);
        const detalle: string[] = [];
        // Solo lo que cambia el precio: las opciones sin costo extra ("Ninguno", "No hace
        // falta") no aportan nada a este resumen.
        $$<HTMLInputElement>(`fieldset[data-servicio="${id}"] .cz-opt > input:checked`).forEach((i) => {
          if (!Number(i.dataset.horas) && !i.dataset.resumen) return;
          const l = i.closest(".cz-opt")?.querySelector(".cz-opt__label")?.textContent?.trim();
          const n = i.closest(".cz-opt")?.querySelector<HTMLInputElement>("input[data-abierto]")?.value;
          if (l) detalle.push(n ? `${l} (${n})` : l);
        });
        if (id === "automatizacion") detalle.push("Se cotiza hablando con vos");
        if (detalle.length) {
          const d = document.createElement("p");
          d.className = "cz-res-item__d";
          d.textContent = detalle.join(" · ");
          item.append(d);
        }
        cont.append(item);
      }
    };

    // ---------- navegación ----------
    // ---------- medición (Google Analytics) ----------
    // Embudo: cotizador_visto -> cotizador_inicio (eligió un servicio) -> cotizador_paso
    // (cada paso que ve) -> cotizador_resultado. Si se va sin llegar al resultado se manda
    // cotizador_abandono con el último paso y el tiempo. window.gtag solo existe en el dominio
    // real, así que en local o en deploy previews esto no hace nada.
    const track = (nombre: string, params: Record<string, unknown> = {}) => {
      if (typeof window.gtag === "function") window.gtag("event", nombre, { send_to: "G-HY78M19P0F", ...params });
    };
    const NOMBRE_PASO: Record<string, string> = {
      "1": "1_servicio",
      "2": "2_detalles",
      "3": "3_contacto",
      auto: "automatizacion",
      resultado: "4_resultado",
    };
    const medicion = {
      inicio: 0, // marca de tiempo del primer servicio elegido (0 = todavía no empezó)
      terminado: false,
      pasos: new Set<string>(),
      ultimoPaso: "1",
      abandonoEnviado: false,
    };
    const servicioActual = () => seleccion()[0] ?? "";
    const segundos = () => (medicion.inicio ? Math.round((Date.now() - medicion.inicio) / 1000) : 0);
    const registrarPaso = (paso: string) => {
      medicion.ultimoPaso = paso;
      medicion.abandonoEnviado = false; // hubo avance: un nuevo abandono vuelve a contar
      // El resultado ya tiene su propio evento (cotizador_resultado).
      if (paso === "resultado" || !medicion.inicio || medicion.pasos.has(paso)) return;
      medicion.pasos.add(paso);
      track("cotizador_paso", { paso: NOMBRE_PASO[paso] ?? paso, servicio: servicioActual(), segundos: segundos() });
    };
    const empezar = () => {
      if (medicion.inicio) return;
      medicion.inicio = Date.now();
      track("cotizador_inicio", { servicio: servicioActual() });
    };
    const reiniciarMedicion = () => {
      medicion.inicio = 0;
      medicion.terminado = false;
      medicion.pasos.clear();
      medicion.ultimoPaso = "1";
      medicion.abandonoEnviado = false;
    };
    const avisarAbandono = () => {
      if (!medicion.inicio || medicion.terminado || medicion.abandonoEnviado) return;
      medicion.abandonoEnviado = true;
      track("cotizador_abandono", {
        ultimo_paso: NOMBRE_PASO[medicion.ultimoPaso] ?? medicion.ultimoPaso,
        servicio: servicioActual(),
        segundos: segundos(),
        transport_type: "beacon",
      });
    };
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") avisarAbandono();
    });
    window.addEventListener("pagehide", avisarAbandono);
    if ("IntersectionObserver" in window) {
      const visto = new IntersectionObserver(
        (entradas) => {
          if (!entradas.some((e) => e.isIntersecting)) return;
          track("cotizador_visto");
          visto.disconnect();
        },
        { threshold: 0.35 }
      );
      visto.observe(app);
    }

    // Hasta qué paso numerado llegó la persona: la barra de progreso deja volver (o
    // adelantar) solo a pasos ya recorridos. El botón "atrás" del navegador también
    // recorre los pasos, porque cada uno se guarda en el historial.
    let maxPaso = 1;
    const mostrar = (paso: Paso, enfocar = true, desdeHistorial = false) => {
      if (paso === "2") {
        const sel = seleccion();
        $$<HTMLElement>("[data-paso='2'] [data-servicio]").forEach((g) => (g.hidden = !sel.includes(g.dataset.servicio ?? "")));
      }
      $$<HTMLElement>("[data-paso]").forEach((el) => (el.hidden = el.dataset.paso !== paso));
      const n = paso === "1" ? 1 : paso === "2" ? 2 : paso === "3" ? 3 : 0;
      if (n) maxPaso = Math.max(maxPaso, n);
      registrarPaso(paso);
      if (!desdeHistorial) {
        try {
          if (history.state?.cz !== paso) history.pushState({ cz: paso }, "");
        } catch {}
      }
      $$<HTMLButtonElement>("[data-barra]").forEach((b) => {
        const i = Number(b.dataset.barra);
        b.classList.toggle("is-on", i <= (n || 3));
        b.disabled = i > maxPaso || i === n;
      });
      const nota = $<HTMLElement>("#cz-side-nota");
      if (nota) nota.hidden = paso === "resultado";
      const label = $("#cz-paso-label");
      if (label)
        label.textContent =
          paso === "resultado" ? "Listo · Tu estimación" : paso === "auto" ? "Automatización" : `Paso ${n} de 3 · ${TITULOS[paso]}`;
      if (enfocar) {
        const h = $<HTMLElement>(`[data-paso="${paso}"] .cz-titulo`);
        h?.focus({ preventScroll: true });
        app.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      }
    };

    // ---------- acciones ----------
    app.addEventListener("click", (e) => {
      const barra = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-barra]");
      if (barra && !barra.disabled) {
        const i = barra.dataset.barra as "1" | "2" | "3";
        // Con solo "Automatización" elegida no hay pasos 2 y 3: el paso 1 es el único destino.
        const soloAuto = seleccion().length === 1 && seleccion()[0] === "automatizacion";
        mostrar(soloAuto && i !== "1" ? "1" : i);
        return;
      }
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-accion]");
      if (!btn) return;
      const accion = btn.dataset.accion;
      if (accion === "siguiente-1") {
        const sel = seleccion();
        const err = $("#cz-error-1");
        if (!sel.length) {
          if (err) err.hidden = false;
          return;
        }
        if (err) err.hidden = true;
        if (sel.length === 1 && sel[0] === "automatizacion") mostrar("auto");
        else mostrar("2");
      } else if (accion === "volver-2" || accion === "volver-auto") mostrar("1");
      else if (accion === "siguiente-2") {
        if (PEDIR_EMAIL) mostrar("3");
        else {
          // Modo prueba: sin email, directo al resultado (no se envía nada ni se mide el lead).
          const sel = seleccion();
          renderResultado(sel, calcular(sel, leerRespuestas(sel)));
        }
      }
      else if (accion === "volver-3" || accion === "editar") mostrar("2");
      else if (accion === "reiniciar") {
        // Vuelve cada campo al valor con el que vino el HTML (la primera opción marcada,
        // las cantidades en su valor inicial, nada elegido en el paso 1).
        $$<HTMLInputElement>("input").forEach((i) => {
          i.checked = i.defaultChecked;
          if (i.type === "number") i.value = i.defaultValue;
        });
        $<HTMLFormElement>("#cz-form")?.reset();
        sincronizar();
        maxPaso = 1;
        reiniciarMedicion();
        mostrar("1");
      }
    });

    window.addEventListener("popstate", (e) => {
      const paso = e.state?.cz as Paso | undefined;
      const sel = seleccion();
      // Sin selección no hay nada que mostrar más allá del paso 1.
      if (!paso || !sel.length || (paso === "resultado" && !$("#cz-resultado")?.innerHTML)) mostrar("1", false, true);
      else mostrar(paso, false, true);
    });

    app.addEventListener("change", (e) => {
      if ((e.target as HTMLInputElement).name === "srv") empezar();
      sincronizar();
    });
    // Las cantidades actualizan el resumen mientras se escribe, no recién al salir del campo.
    app.addEventListener("input", (e) => {
      if ((e.target as HTMLElement).matches("input[type=number]")) renderResumen();
    });
    // Tocar la cantidad de un escalón abierto ("más de 100") lo selecciona.
    app.addEventListener("focusin", (e) => {
      const n = (e.target as HTMLElement).closest<HTMLInputElement>("input[data-abierto]");
      if (!n) return;
      const radio = n.closest(".cz-opt")?.querySelector<HTMLInputElement>("input[type=radio]");
      if (radio && !radio.checked) {
        radio.checked = true;
        sincronizar();
      }
    });

    // ---------- resultado ----------
    const rango = (min: number, max: number) => `USD ${usd(min)} a ${usd(max)}`;

    const textoLineas = (res: Resultado) =>
      res.lineas
        .map((l) => `${l.servicio} | ${l.concepto} | USD ${l.usd}${l.mensual ? "/mes" : ""} | ${l.horas} h`)
        .join("\n");

    const renderResultado = (sel: string[], res: Resultado) => {
      const cont = $("#cz-resultado");
      if (!cont) return;
      const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
      const monto = (min: number, max: number) =>
        `<span class="cz-res-usd">USD</span>${usd(min)}<span class="cz-res-a"> a </span>${usd(max)}`;
      let html = '<div class="cz-res-hero"><p class="cz-res-kicker">Tu estimación</p>';
      if (res.unico > 0)
        html += `<p class="cz-res-monto">${monto(res.unico, res.unicoMax)}</p><p class="cz-res-sub">Proyecto, pago único</p>`;
      if (res.mensual > 0)
        html += `<p class="cz-res-monto"${res.unico > 0 ? ' style="margin-top:26px"' : ""}><span class="cz-res-usd">USD</span>${usd(res.mensual)} <small>por mes</small></p><p class="cz-res-sub">Mantenimiento mensual</p>`;
      html += "</div>";

      const servicios = [...new Set(res.lineas.map((l) => l.servicio))];
      html += '<div class="cz-res-bloque"><h3>Cómo lo calculamos</h3>';
      for (const s of servicios) {
        html += `<p class="cz-res-srv">${esc(s)}</p>`;
        const delServicio = res.lineas.filter((x) => x.servicio === s);
        const descuento = delServicio.find((x) => x.descuento);
        const normales = delServicio.filter((x) => !x.descuento);
        const fila = (clase: string, texto: string, monto: string) =>
          `<div class="cz-res-linea${clase}"><span>${esc(texto)}</span><b>${monto}</b></div>`;
        for (const l of normales) html += fila("", l.concepto, `USD ${usd(l.usd)}${l.mensual ? "/mes" : ""}`);
        if (descuento) {
          const subtotal = normales.filter((x) => !x.mensual).reduce((a, x) => a + x.usd, 0);
          html += fila(" cz-res-linea--sub", "Subtotal", `USD ${usd(subtotal)}`);
          html += fila(" cz-res-linea--desc", descuento.concepto, `−USD ${usd(Math.abs(descuento.usd))}`);
          html += fila(" cz-res-linea--total", "Total", `USD ${usd(subtotal + descuento.usd)}`);
        }
      }
      html += "</div>";

      const plazos = sel
        .filter((id) => id !== "automatizacion")
        .map((id) => SERVICIOS.find((s) => s.id === id))
        .filter((s) => s?.plazo)
        .map((s) => `<li><b>${esc(s!.titulo)}:</b> ${esc(s!.plazo!)}</li>`);
      if (plazos.length) html += `<div class="cz-res-bloque"><h3>Plazos orientativos</h3><ul class="cz-res-lista">${plazos.join("")}</ul></div>`;

      const avisos = new Set<string>();
      for (const id of sel) {
        const a = SERVICIOS.find((s) => s.id === id)?.aviso;
        if (a) avisos.add(a);
      }
      if (res.lineas.some((l) => l.diseno))
        avisos.add(
          "El diseño incluye un primer bosquejo de la home, una página interna, la página de contacto y una entrada de blog, con hasta 3 rondas de cambios. Los cambios adicionales se cotizan aparte."
        );
      if (res.promoMant) {
        const pm = res.promoMant;
        avisos.add(
          `El descuento del ${pm.descuentoPct}% ${pm.paraTienda ? "en la tienda" : "en el sitio"} se aplica al contratar el ${pm.nombre} de mantenimiento (USD ${pm.plan} por mes) con una permanencia mínima de ${pm.meses} meses. Incluye backups, actualizaciones y seguridad, más ${pm.horas} horas al mes para correcciones o tareas nuevas. Las horas no se acumulan para el mes siguiente.`
        );
      }
      for (const p of res.pedidos) avisos.add(`${p.split(" | ").slice(1).join(" | ")}.`);
      if (sel.some((id) => ["institucional", "landing", "tienda", "mantenimiento"].includes(id)))
        avisos.add(
          "Los precios no incluyen hosting y dominio, licencias de plugins o herramientas de pago, ni comisiones de los medios de pago."
        );
      if (res.conAutomatizacion)
        avisos.add("Para automatizaciones necesitamos conocer tu caso: escribinos y lo vemos, no se incluye en esta estimación.");
      if (res.unico > 0) avisos.add("El valor menor es el precio calculado con lo que respondiste; el mayor deja un 30% de margen para los detalles que se definen cuando conversamos el proyecto. El precio cerrado lo confirmamos antes de arrancar. Si más adelante pedís algo que no estaba acordado, te lo cotizamos aparte antes de hacerlo.");
      if (res.mensual > 0) avisos.add("El mantenimiento mensual es un valor fijo, sin rango.");
      html += `<div class="cz-res-bloque"><h3>A tener en cuenta</h3><ul class="cz-res-lista">${[...avisos].map((a) => `<li>${esc(a)}</li>`).join("")}</ul></div>`;

      const resumenWa = `Hola! Hice una cotización en el cotizador de efedigital: ${sel.map(tituloServicio).join(", ")}. Estimación: ${[
        res.unico > 0 ? rango(res.unico, res.unicoMax) : "",
        res.mensual > 0 ? `USD ${usd(res.mensual)} por mes` : "",
      ]
        .filter(Boolean)
        .join(" + ")}.`;
      html += `<div class="cz-acciones" style="margin-top:32px">
        <a class="efe-btn efe-btn--primary" href="${wa(resumenWa)}" target="_blank" rel="noopener noreferrer">Hablemos por WhatsApp ↗</a>
        <button type="button" class="efe-btn efe-btn--ghost" data-accion="editar">← Modificar respuestas</button>
        <button type="button" class="efe-btn efe-btn--ghost" data-accion="reiniciar">Hacer otra cotización</button>
      </div>
      <p class="cz-res-pie">Estimación sin compromiso. El precio cerrado se confirma antes de arrancar.${PEDIR_EMAIL ? " Te escribimos a tu mail con los próximos pasos." : ""}</p>`;
      cont.innerHTML = html;
      medicion.terminado = true;
      track("cotizador_resultado", {
        servicio: sel[0] ?? "",
        value: res.unico || res.mensual,
        currency: "USD",
        con_mantenimiento: !!res.promoMant,
        segundos: segundos(),
      });
      mostrar("resultado");
    };

    // ---------- envío ----------
    const form = $<HTMLFormElement>("#cz-form");
    const btnEnviar = $<HTMLButtonElement>("#cz-enviar");
    const textoEnviar = $("#cz-enviar-texto");
    const errorForm = $<HTMLElement>("#cz-error-3");
    let enviando = false;

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (enviando || !form) return;
      const sel = seleccion();
      if (!sel.length) return mostrar("1");
      const res = calcular(sel, leerRespuestas(sel));
      const set = (n: string, v: string) => {
        const i = form.elements.namedItem(n) as HTMLInputElement | null;
        if (i) i.value = v;
      };
      set("servicios", sel.map(tituloServicio).join(", "));
      set("detalle", [textoLineas(res) || "Sin ítems con precio", ...res.pedidos.map((p) => `Pedidos | ${p}`)].join("\n"));
      set("estimacion", res.unico > 0 ? rango(res.unico, res.unicoMax) : "");
      set("mensualidad", res.mensual > 0 ? `USD ${usd(res.mensual)} por mes` : "");
      set("horas", String(res.horas));

      enviando = true;
      btnEnviar?.setAttribute("disabled", "true");
      if (textoEnviar) textoEnviar.textContent = "Enviando…";
      if (errorForm) errorForm.hidden = true;
      try {
        // En local (npm run dev:cotizador / preview) no hay Netlify Forms: se muestra el
        // resultado igual, sin enviar nada, para poder revisar el flujo completo.
        if (!esLocal) {
          const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
          const r = await fetch(form.getAttribute("action") || "/", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body,
          });
          if (!r.ok) throw new Error("submit failed");
        }
        if (typeof window.gtag === "function") {
          // Misma conversión de Google Ads que el formulario de contacto (ContactForm.astro).
          window.gtag("event", "conversion", { send_to: "AW-18451433875/rbaXCOyP4_ccEJOTqt5E" });
          window.gtag("event", "generate_lead", { send_to: "G-HY78M19P0F", form_name: "cotizador" });
        }
        renderResultado(sel, res);
      } catch {
        track("cotizador_error_envio", { servicio: servicioActual() });
        if (errorForm) {
          errorForm.textContent = `No pudimos enviar tu pedido. Reintentá en un momento o escribinos por WhatsApp (${WHATSAPP}).`;
          errorForm.hidden = false;
        }
      } finally {
        enviando = false;
        btnEnviar?.removeAttribute("disabled");
        if (textoEnviar) textoEnviar.textContent = "Ver mi estimación";
      }
    });

    sincronizar();
    try {
      history.replaceState({ cz: "1" }, "");
    } catch {}
    mostrar("1", false, true);
  }
</script>
