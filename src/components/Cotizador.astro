---
import { SERVICIOS } from "../data/cotizador/precios";
import { wa } from "../data/cotizador/contacto";
import { PEDIR_EMAIL } from "../data/cotizador/config";

const ICONOS: Record<string, string> = {
  institucional: '<rect x="3" y="4" width="18" height="16"/><path d="M3 9h18M6.5 6.5h.01M9.5 6.5h.01M7 13h10M7 16h6"/>',
  landing: '<path d="M5 3h14v18H5z"/><path d="M8 7h8M8 10.5h5"/><path d="M8 15h8v3H8z"/>',
  tienda: '<path d="M3 4h2.5l2 11h10.5l2-8H6.6"/><circle cx="9" cy="19" r="1.3"/><circle cx="17" cy="19" r="1.3"/>',
  mantenimiento: '<path d="M14.5 6a4 4 0 0 0-5.2 5.2L4 16.5 7.5 20l5.3-5.3A4 4 0 0 0 18 9.5L15.2 12l-2.7-.7-.7-2.7z"/>',
  optimizacion: '<path d="M13 3 5 13.5h6L10 21l8-10.5h-6z"/>',
  auditoria: '<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5.5 5.5M8 10.5h5M10.5 8v5"/>',
  automatizacion: '<path d="M4 12a8 8 0 0 1 14-5.3L20 9M20 12a8 8 0 0 1-14 5.3L4 15"/><path d="M20 4v5h-5M4 20v-5h5"/>',
};
const conPreguntas = SERVICIOS.filter((s) => s.id !== "automatizacion");
const textoAuto =
  "Para automatizaciones necesitamos conocer tu caso: cada flujo depende de las herramientas que uses, así que no lo cotizamos desde acá. Escribinos y lo vemos.";
const waAuto = wa("Hola! Quiero consultar por una automatización.");
---

<div id="cz-app" class="cz-app">
  <div class="cz-main">
    <noscript>
      <p class="cz-error">El cotizador necesita JavaScript. Podés escribirnos por WhatsApp o mail y te cotizamos igual.</p>
    </noscript>
    <div class="cz-progress" style={`--cols:${PEDIR_EMAIL ? 3 : 2}`}>
      <button type="button" data-barra="1" class="is-on" aria-label="Ir al paso 1"><i>01</i><span>Servicio</span></button>
      <button type="button" data-barra="2" aria-label="Ir al paso 2" disabled><i>02</i><span>Detalles</span></button>
      {PEDIR_EMAIL && (
        <button type="button" data-barra="3" aria-label="Ir al paso 3" disabled><i>03</i><span>Contacto</span></button>
      )}
    </div>
    <p class="cz-paso-label cz-sr" id="cz-paso-label" aria-live="polite">Paso 1 de 3 · ¿Qué necesitás?</p>

    <!-- PASO 1 -->
    <div data-paso="1">
      <span class="cz-bignum" aria-hidden="true">01</span>
      <h2 class="cz-titulo" tabindex="-1">¿Qué necesitás?</h2>
      <p class="cz-ayuda">Elegí una opción. Si necesitás más de un servicio, podés hacer otra cotización después.</p>
      <div class="cz-grid">
        {
          SERVICIOS.map((s) => (
            <label class="cz-card">
              <input type="radio" name="srv" value={s.id} class="cz-oculto" />
              <span class="cz-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" set:html={ICONOS[s.id]} />
              </span>
              <span class="cz-card__check" aria-hidden="true">✓</span>
              <span class="cz-card__title">{s.titulo}</span>
              <span class="cz-card__desc">{s.resumen}</span>
            </label>
          ))
        }
      </div>
      <p class="cz-error" id="cz-error-1" role="alert" hidden>Elegí un servicio para continuar.</p>
      <div class="cz-acciones">
        <button type="button" class="efe-btn efe-btn--primary" data-accion="siguiente-1">
          Siguiente <span style="font-size:14px">→</span>
        </button>
      </div>
    </div>

    <!-- PASO 2 -->
    <div data-paso="2" hidden>
      <span class="cz-bignum" aria-hidden="true">02</span>
      <h2 class="cz-titulo" tabindex="-1">Contanos un poco más</h2>
      <p class="cz-ayuda">Dejamos marcada la opción más chica de cada pregunta; cambiala si no es tu caso.</p>
      {
        conPreguntas.map((s) => (
          <fieldset class="cz-grupo" data-servicio={s.id} hidden>
            <legend class="cz-grupo__titulo">{s.titulo}</legend>
            {s.preguntas.map((q) => (
              <div class="cz-pregunta">
                <p class="cz-pregunta__label" id={`q-${s.id}-${q.id}`}>
                  {q.label}
                </p>
                {q.ayuda && <p class="cz-pregunta__ayuda">{q.ayuda}</p>}
                {q.fija ? (
                  <p class="cz-fija">
                    {q.opciones?.[0]?.label} <span>· incluido en la estimación</span>
                  </p>
                ) : q.tipo === "numero" ? (
                  <input
                    type="number"
                    min="0"
                    max={q.max}
                    value="0"
                    inputmode="numeric"
                    class="cz-input cz-num"
                    name={`${s.id}.${q.id}`}
                    aria-labelledby={`q-${s.id}-${q.id}`}
                  />
                ) : (
                  <div
                    class:list={["cz-opciones", (q.opciones ?? []).length <= 3 && "cz-opciones--iguales"]}
                    style={`--n:${(q.opciones ?? []).length}`}
                    role={q.tipo === "una" ? "radiogroup" : "group"}
                    aria-labelledby={`q-${s.id}-${q.id}`}
                  >
                    {(q.opciones ?? []).map((o, i) => (
                      <label class="cz-opt">
                        <input
                          type={q.tipo === "una" ? "radio" : "checkbox"}
                          name={`${s.id}.${q.id}`}
                          value={o.id}
                          checked={q.tipo === "una" && i === 0}
                          data-horas={o.horas}
                          data-resumen={o.resumen ? "1" : undefined}
                          data-horasmes={o.horasMes}
                          data-cap={o.capacidad}
                          class="cz-oculto"
                        />
                        <span class="cz-opt__label">{o.label}</span>
                        {o.desc && <span class="cz-opt__desc">{o.desc}</span>}
                        {o.abierto && (
                          <span class="cz-opt__n">
                            <input
                              type="number"
                              min={o.abierto.desde}
                              value={o.abierto.desde + o.abierto.bloque}
                              inputmode="numeric"
                              class="cz-input cz-num cz-num--chico"
                              name={`${s.id}.${q.id}__n`}
                              aria-label={`Cantidad aproximada de ${o.abierto.unidad}`}
                              data-abierto
                            />
                            <span>{o.abierto.unidad} aprox.</span>
                          </span>
                        )}
                      </label>
                    ))}
                  </div>
                )}
                {(q.opciones ?? []).some((o) => o.capacidad !== undefined) && <p class="cz-recom" data-recom hidden />}
              </div>
            ))}
            {s.aviso && <p class="cz-aviso">{s.aviso}</p>}
          </fieldset>
        ))
      }
      <div class="cz-grupo cz-auto" data-servicio="automatizacion" hidden>
        <p class="cz-grupo__titulo">Automatización</p>
        <p class="cz-auto__texto">{textoAuto}</p>
        <div class="cz-auto__botones">
          <a href={waAuto} target="_blank" rel="noopener noreferrer" class="efe-btn efe-btn--ghost">WhatsApp ↗</a>
          <a href="/contacto/" class="efe-btn efe-btn--ghost">Contactanos ↗</a>
        </div>
      </div>
      <div class="cz-acciones">
        <button type="button" class="efe-btn efe-btn--ghost" data-accion="volver-2">← Volver</button>
        <button type="button" class="efe-btn efe-btn--primary" data-accion="siguiente-2">
          {PEDIR_EMAIL ? "Siguiente" : "Ver mi estimación"} <span style="font-size:14px">{PEDIR_EMAIL ? "→" : "↗"}</span>
        </button>
      </div>
    </div>

    <!-- PASO 3 -->
    <div data-paso="3" hidden>
      <span class="cz-bignum" aria-hidden="true">03</span>
      <h2 class="cz-titulo" tabindex="-1">¿A dónde te mandamos la estimación?</h2>
      <p class="cz-ayuda">La ves en pantalla al instante, y nosotros la recibimos para armar el precio cerrado con vos.</p>
      <form
        name="cotizador"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        id="cz-form"
        class="cz-form"
      >
        <input type="hidden" name="form-name" value="cotizador" />
        <p style="display:none">
          <label>No completar si sos humano: <input name="bot-field" /></label>
        </p>
        <input type="hidden" name="servicios" />
        <input type="hidden" name="detalle" />
        <input type="hidden" name="estimacion" />
        <input type="hidden" name="mensualidad" />
        <input type="hidden" name="horas" />
        <label class="cz-campo">
          Email
          <input type="email" name="email" required autocomplete="email" placeholder="tu@empresa.com" class="cz-input" />
        </label>
        <label class="cz-campo">
          Nombre y apellido
          <input type="text" name="nombre" required autocomplete="name" placeholder="Nombre y apellido" class="cz-input" />
        </label>
        <label class="cz-consent">
          <input type="checkbox" name="consentimiento" value="si" required />
          <span>
            Acepto que efedigital me escriba a este mail con mi estimación y para coordinar el proyecto. Usamos tu mail
            solo para eso.
          </span>
        </label>
        <p class="cz-error" id="cz-error-3" role="alert" hidden></p>
        <div class="cz-acciones">
          <button type="button" class="efe-btn efe-btn--ghost" data-accion="volver-3">← Volver</button>
          <button type="submit" class="efe-btn efe-btn--primary" id="cz-enviar">
            <span id="cz-enviar-texto">Ver mi estimación</span> <span style="font-size:14px">↗</span>
          </button>
        </div>
      </form>
    </div>

    <!-- SOLO AUTOMATIZACIÓN -->
    <div data-paso="auto" hidden>
      <h2 class="cz-titulo" tabindex="-1">Automatización</h2>
      <p class="cz-auto__texto cz-auto__texto--grande">{textoAuto}</p>
      <div class="cz-acciones">
        <a href={waAuto} target="_blank" rel="noopener noreferrer" class="efe-btn efe-btn--primary">Hablemos por WhatsApp ↗</a>
        <a href="/contacto/" class="efe-btn efe-btn--ghost">Contactanos ↗</a>
        <button type="button" class="efe-btn efe-btn--ghost" data-accion="volver-auto">← Volver</button>
      </div>
    </div>

    <!-- RESULTADO (lo arma el script) -->
    <div data-paso="resultado" hidden>
      <div id="cz-resultado" aria-live="polite"></div>
    </div>
  </div>

  <div class="cz-col">
  <aside class="cz-side" aria-label="Resumen de tu proyecto">
    <p class="cz-side__titulo">Tu proyecto</p>
    <div id="cz-resumen" class="cz-resumen">
      <p class="cz-side__vacio">Todavía no elegiste nada.</p>
    </div>
    <div class="cz-side__incl">
      <p class="cz-side__titulo">Los precios no incluyen</p>
      <ul>
        <li>Hosting y dominio</li>
        <li>Licencias de plugins o herramientas de pago</li>
        <li>Comisiones de los medios de pago</li>
      </ul>
    </div>
    {PEDIR_EMAIL && <p class="cz-side__nota" id="cz-side-nota">La estimación aparece al final, después de dejar tu mail.</p>}
  </aside>
  <div class="cz-agencia-card">
    <p class="cz-agencia-card__t">¿Sos una agencia?</p>
    <p class="cz-agencia-card__d">
      ¿O querés trabajar con nosotros de forma continua? Contactanos y armamos una propuesta a medida.
    </p>
    <a href="/contacto/" class="cz-agencia-card__a">Contactanos ↗</a>
  </div>
  </div>
</div>

<style is:global>
  .cz-app [hidden] {
    display: none !important;
  }
  .cz-oculto {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .cz-app {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    scroll-margin-top: 90px;
  }
  @media (max-width: 980px) {
    .cz-app {
      grid-template-columns: 1fr;
    }
    .cz-side {
      display: none;
    }
  }

  .cz-main {
    padding: clamp(24px, 3vw, 40px);
    background:
      radial-gradient(70% 40% at 0% 0%, rgba(212, 255, 63, 0.09), rgba(212, 255, 63, 0) 70%),
      radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px) 0 0 / 22px 22px,
      #0f0f13;
    border: 1px solid rgba(255, 255, 255, 0.12);
    min-width: 0;
  }
  .cz-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cz-progress {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: 6px;
  }
  .cz-progress button {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 14px 0 0;
    border: 0;
    background: none;
    text-align: left;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #6c6c74;
    cursor: default;
    transition: color 0.25s ease;
  }
  .cz-progress button i {
    font-style: normal;
    font-weight: 500;
  }
  .cz-progress button::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    transition: background 0.3s ease, height 0.2s ease;
  }
  .cz-progress button.is-on {
    color: #f5f2ec;
  }
  .cz-progress button.is-on i {
    color: #d4ff3f;
  }
  .cz-progress button.is-on::before {
    background: #d4ff3f;
  }
  .cz-progress button:not(:disabled) {
    cursor: pointer;
  }
  .cz-progress button:not(:disabled):hover::before {
    height: 5px;
  }
  .cz-progress button:focus-visible {
    outline: 2px solid #d4ff3f;
    outline-offset: 2px;
  }
  @media (max-width: 520px) {
    .cz-progress button {
      gap: 6px;
      font-size: 10px;
      letter-spacing: 0.08em;
    }
  }
  .cz-paso-label {
    margin: 14px 0 0;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8b8b93;
  }

  .cz-titulo {
    margin: clamp(24px, 3vw, 36px) 0 0;
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1;
    letter-spacing: -0.03em;
    outline: none;
  }
  .cz-titulo:focus,
  .cz-titulo:focus-visible {
    outline: none;
  }
  .cz-ayuda {
    margin: 12px 0 0;
    max-width: 58ch;
    font-size: 15px;
    line-height: 1.6;
    color: #a9a9b1;
  }

  .cz-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 12px;
    margin-top: 24px;
  }
  .cz-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 20px 22px;
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.14);
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease, translate 0.25s ease, box-shadow 0.25s ease;
  }
  .cz-card:hover {
    translate: 0 -3px;
    border-color: rgba(212, 255, 63, 0.7);
    background: #121218;
    box-shadow: 4px 4px 0 rgba(212, 255, 63, 0.3);
  }
  .cz-card:has(input:focus-visible) {
    outline: 2px solid #d4ff3f;
    outline-offset: 2px;
  }
  .cz-card.is-on {
    border-color: #d4ff3f;
    background: linear-gradient(160deg, rgba(212, 255, 63, 0.14), rgba(212, 255, 63, 0.04));
    box-shadow: 5px 5px 0 #d4ff3f;
    translate: 0 -3px;
  }
  .cz-card__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 6px;
    border: 1px solid rgba(212, 255, 63, 0.35);
    background: rgba(212, 255, 63, 0.06);
    color: #d4ff3f;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .cz-card:hover .cz-card__icon {
    border-color: #d4ff3f;
  }
  .cz-card.is-on .cz-card__icon {
    background: #d4ff3f;
    border-color: #d4ff3f;
    color: #08080a;
  }
  [data-paso] {
    position: relative;
  }
  .cz-bignum {
    position: absolute;
    top: 6px;
    right: 0;
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: clamp(64px, 9vw, 120px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(212, 255, 63, 0.28);
    pointer-events: none;
    user-select: none;
  }
  @media (max-width: 520px) {
    .cz-bignum {
      display: none;
    }
  }
  .cz-card__check {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 12px;
    color: transparent;
    transition: all 0.2s ease;
  }
  .cz-card.is-on .cz-card__check {
    background: #d4ff3f;
    border-color: #d4ff3f;
    color: #08080a;
  }
  .cz-card__title {
    font-family: "Lora", serif;
    font-weight: 700;
    font-size: 19px;
    line-height: 1.15;
    color: #f5f2ec;
  }
  .cz-card__desc {
    font-size: 13.5px;
    line-height: 1.45;
    color: #8b8b93;
  }

  .cz-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
  .cz-error {
    margin: 16px 0 0;
    padding: 10px 14px;
    border: 1px solid rgba(255, 120, 120, 0.5);
    background: rgba(255, 90, 90, 0.08);
    font-size: 13.5px;
    color: #ffb4b4;
  }

  .cz-grupo {
    margin: 32px 0 0;
    padding: 0 0 4px;
    border: 0;
    min-width: 0;
  }
  .cz-grupo__titulo {
    display: inline-block;
    padding: 6px 12px;
    margin: 0;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    background: #d4ff3f;
    color: #08080a;
  }
  .cz-grupo > legend + .cz-pregunta,
  .cz-grupo > .cz-grupo__titulo + .cz-auto__texto {
    margin-top: 16px;
  }
  .cz-pregunta {
    margin-top: 26px;
  }
  .cz-pregunta + .cz-pregunta {
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .cz-pregunta__label {
    margin: 0;
    font-size: 15.5px;
    font-weight: 600;
    color: #f5f2ec;
  }
  .cz-pregunta__ayuda {
    margin: 6px 0 0;
    max-width: 62ch;
    font-size: 13px;
    line-height: 1.55;
    color: #8b8b93;
  }
  .cz-opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  /* Preguntas con 2 o 3 opciones: cajas del mismo ancho. */
  .cz-opciones--iguales {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    max-width: 760px;
  }
  .cz-opciones--iguales .cz-opt {
    min-width: 0;
  }
  .cz-opciones--iguales .cz-opt__desc {
    max-width: none;
  }
  @media (max-width: 640px) {
    .cz-opciones--iguales {
      grid-template-columns: 1fr;
    }
  }
  .cz-opt {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 13px 16px 13px 46px;
    min-width: 150px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.16);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .cz-opt::before {
    content: "";
    position: absolute;
    left: 16px;
    top: 15px;
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .cz-opt.is-on::before {
    border-color: #d4ff3f;
    background: #d4ff3f;
    box-shadow: inset 0 0 0 3px #0f0f13;
  }
  .cz-opt:hover {
    border-color: rgba(212, 255, 63, 0.6);
    background: rgba(255, 255, 255, 0.025);
  }
  .cz-opt:has(input:focus-visible) {
    outline: 2px solid #d4ff3f;
    outline-offset: 2px;
  }
  .cz-fija {
    margin: 12px 0 0;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #f5f2ec;
  }
  .cz-fija span {
    color: #8b8b93;
  }
  .cz-opt.is-corto {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .cz-opt.is-corto:hover {
    border-color: rgba(255, 255, 255, 0.16);
    background: transparent;
  }
  .cz-recom {
    margin: 12px 0 0;
    padding: 10px 14px;
    border: 1px solid rgba(212, 255, 63, 0.35);
