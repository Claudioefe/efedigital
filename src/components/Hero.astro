---
---

<section
  id="top"
  style="position:relative;z-index:1;min-height:calc(100vh - 66px);display:flex;flex-direction:column;justify-content:center;padding:clamp(48px,7vw,96px) clamp(18px,3.5vw,52px);overflow:hidden"
>
  <div
    aria-hidden="true"
    data-hero-corner
    style="position:absolute;top:clamp(24px,3vw,44px);left:clamp(18px,3.5vw,52px);width:26px;height:26px;border-left:1px solid #D4FF3F;border-top:1px solid #D4FF3F;pointer-events:none;animation:efe-corner-tl 4.6s ease-in-out infinite"
  >
  </div>
  <div
    aria-hidden="true"
    data-hero-corner
    style="position:absolute;top:clamp(24px,3vw,44px);right:clamp(18px,3.5vw,52px);width:26px;height:26px;border-right:1px solid #D4FF3F;border-top:1px solid #D4FF3F;pointer-events:none;animation:efe-corner-tr 4.6s ease-in-out .12s infinite"
  >
  </div>
  <div
    aria-hidden="true"
    data-hero-corner
    style="position:absolute;bottom:clamp(24px,3vw,44px);left:clamp(18px,3.5vw,52px);width:26px;height:26px;border-left:1px solid #D4FF3F;border-bottom:1px solid #D4FF3F;pointer-events:none;animation:efe-corner-bl 4.6s ease-in-out .24s infinite"
  >
  </div>
  <div
    aria-hidden="true"
    data-hero-corner
    style="position:absolute;bottom:clamp(24px,3vw,44px);right:clamp(18px,3.5vw,52px);width:26px;height:26px;border-right:1px solid #D4FF3F;border-bottom:1px solid #D4FF3F;pointer-events:none;animation:efe-corner-br 4.6s ease-in-out .36s infinite"
  >
  </div>

  <div class="efe-hero-grid" style="position:relative;width:100%;max-width:1440px;margin:0 auto">
    <div>
      <h1 class="efe-h1 efe-hero-title">
        <span style="display:block;overflow:hidden;padding-bottom:.06em"
          ><span class="efe-word" style="animation-delay:.05s">Desarrollo web,</span></span
        >
        <span style="display:block;overflow:hidden;padding-bottom:.06em"
          ><span class="efe-word" style="animation-delay:.17s">e-commerce y</span></span
        >
        <span style="display:block;overflow:hidden;padding-bottom:.06em"
          ><span class="efe-word" style="animation-delay:.29s">automatización</span></span
        >
        <span style="display:block;overflow:hidden;padding-bottom:.06em">
          <span class="efe-word" style="animation-delay:.41s;color:transparent;-webkit-text-stroke:1px #D4FF3F"
            >a medida</span
          >
        </span>
      </h1>

      <p
        class="efe-lede"
        style="max-width:44ch;margin-top:clamp(32px,4.5vw,58px);animation:efe-fade-up .9s cubic-bezier(.16,1,.3,1) .5s both"
      >
        Somos un equipo chico que <span style="color:#EDEDF0">se mete en tu operación</span>: entendemos
        cómo trabajás hoy y construimos el software que te saca <span style="color:#EDEDF0"
          >las planillas, los copy-paste y las horas perdidas</span
        > de encima.
      </p>

      <div
        style="display:flex;flex-wrap:wrap;gap:22px;margin-top:clamp(28px,3.6vw,44px);animation:efe-fade-up .9s cubic-bezier(.16,1,.3,1) .62s both"
      >
        <a href="/contacto" class="efe-btn efe-btn--primary">
          Empezar un proyecto <span style="font-size:14px">↗</span>
        </a>
        <a href="#servicios" class="efe-btn efe-btn--ghost"> Servicios </a>
      </div>
    </div>

    <div data-hero-tilt="8" style="animation:efe-fade-up .9s cubic-bezier(.16,1,.3,1) .74s both">
      <div class="efe-hero-panel">
        <div class="efe-hero-panel__glow" aria-hidden="true"></div>
        <div class="efe-hero-panel__ghost" aria-hidden="true"></div>
        <div class="efe-hero-panel__shape" aria-hidden="true"></div>

        <div
          aria-hidden="true"
          data-hero-corner
          class="efe-hero-panel__corner"
          style="top:0;left:0;border-left:1px solid #D4FF3F;border-top:1px solid #D4FF3F;animation:efe-corner-tl 4.6s ease-in-out infinite"
        >
        </div>
        <div
          aria-hidden="true"
          data-hero-corner
          class="efe-hero-panel__corner"
          style="top:0;right:0;border-right:1px solid #D4FF3F;border-top:1px solid #D4FF3F;animation:efe-corner-tr 4.6s ease-in-out .12s infinite"
        >
        </div>
        <div
          aria-hidden="true"
          data-hero-corner
          class="efe-hero-panel__corner"
          style="bottom:0;left:0;border-left:1px solid #D4FF3F;border-bottom:1px solid #D4FF3F;animation:efe-corner-bl 4.6s ease-in-out .24s infinite"
        >
        </div>
        <div
          aria-hidden="true"
          data-hero-corner
          class="efe-hero-panel__corner"
          style="bottom:0;right:0;border-right:1px solid #D4FF3F;border-bottom:1px solid #D4FF3F;animation:efe-corner-br 4.6s ease-in-out .36s infinite"
        >
        </div>

        <div class="efe-hero-panel__eyebrow efe-hero-panel__layer">
          <span class="efe-hero-panel__eyebrow-dot"></span>
          Automatización en marcha
        </div>

        <div class="efe-hero-panel__steps efe-hero-panel__layer">
          <div class="efe-hero-panel__line" aria-hidden="true"><span class="efe-hero-panel__beam"></span></div>
          {
            [
              { title: "Pedido nuevo", meta: "sincronizado con la tienda" },
              { title: "Factura", meta: "emitida automáticamente" },
              { title: "Cliente", meta: "avisado por WhatsApp" },
              { title: "Stock", meta: "actualizado en tiempo real" },
              { title: "Reporte semanal", meta: "listo sin errores" },
            ].map((step, i) => (
              <div class="efe-hero-step" style={`animation-delay:${0.9 + i * 0.12}s`}>
                <span class="efe-hero-step__dot" style={`animation-delay:${i * 0.35}s`}></span>
                <span class="efe-hero-step__text">
                  <span class="efe-hero-step__title">{step.title}</span>
                  <span class="efe-hero-step__meta">{step.meta}</span>
                </span>
                <span class="efe-hero-step__check" style={`animation-delay:${1.4 + i * 0.35}s`}>✓</span>
              </div>
            ))
          }
        </div>

        <div class="efe-hero-panel__footer efe-hero-panel__layer">
          <span class="efe-hero-panel__num">24/7</span>
          <span class="efe-hero-panel__foot-label">Corriendo sin<br />intervención humana</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .efe-word {
    display: inline-block;
    animation: efe-rise 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .efe-hero-panel {
    position: relative;
    height: 100%;
    min-height: 460px;
    display: flex;
    flex-direction: column;
    gap: clamp(22px, 2.6vw, 32px);
    padding: clamp(26px, 2.8vw, 38px) clamp(24px, 2.6vw, 34px);
  }
  .efe-hero-panel__layer {
    position: relative;
    z-index: 2;
  }
  .efe-hero-panel__corner {
    position: absolute;
    z-index: 3;
    width: 18px;
    height: 18px;
    pointer-events: none;
  }

  /* Irregular, slowly-morphing shape layers instead of a plain rectangle */
  .efe-hero-panel__shape {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(120% 140% at 100% 0%, rgba(212, 255, 63, 0.08), transparent 55%),
      rgba(13, 13, 16, 0.76);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    clip-path: polygon(0 0, calc(100% - 44px) 0, 100% 26px, 100% 100%, 36px 100%, 0 calc(100% - 52px));
    animation: efe-hero-shape-morph 11s ease-in-out infinite;
  }
  @keyframes efe-hero-shape-morph {
    0%,
    100% {
      clip-path: polygon(0 0, calc(100% - 44px) 0, 100% 26px, 100% 100%, 36px 100%, 0 calc(100% - 52px));
    }
    35% {
      clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 58px, 100% 100%, 58px 100%, 0 calc(100% - 24px));
    }
    70% {
      clip-path: polygon(0 0, calc(100% - 60px) 0, 100% 14px, 100% calc(100% - 30px), 20px 100%, 0 60px);
    }
  }
  .efe-hero-panel__ghost {
    position: absolute;
    inset: -13px;
    z-index: -1;
    border: 1px solid rgba(212, 255, 63, 0.32);
    clip-path: polygon(34px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 54px) 100%, 0 100%, 0 46px);
    animation: efe-hero-ghost-float 8.5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes efe-hero-ghost-float {
    0%,
    100% {
      transform: translate(0, 0) rotate(-0.7deg);
    }
    50% {
      transform: translate(6px, -7px) rotate(0.8deg);
    }
  }
  .efe-hero-panel__glow {
    position: absolute;
    z-index: -2;
    width: 230px;
    height: 230px;
    top: -70px;
    right: -60px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(212, 255, 63, 0.18), transparent 72%);
    filter: blur(4px);
    animation: efe-hero-glow-float 12s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes efe-hero-glow-float {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-22px, 28px) scale(1.2);
    }
  }
  .efe-hero-panel__eyebrow {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8b8b93;
  }
  .efe-hero-panel__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4ff3f;
    animation: efe-pulse 2.2s ease-in-out infinite;
  }

  .efe-hero-panel__steps {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .efe-hero-panel__line {
    position: absolute;
    left: 3px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.14) 0 4px, transparent 4px 10px);
    overflow: hidden;
  }
  .efe-hero-panel__beam {
    position: absolute;
    left: 0;
    top: -40%;
    width: 100%;
    height: 40%;
    background: linear-gradient(to bottom, transparent, #d4ff3f, transparent);
    animation: efe-hero-beam 3.6s ease-in-out infinite;
  }
  @keyframes efe-hero-beam {
    0% {
      transform: translateY(-20%);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translateY(280%);
      opacity: 0;
    }
  }

  .efe-hero-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    opacity: 0;
    animation: efe-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .efe-hero-step__dot {
    position: relative;
    z-index: 1;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid #d4ff3f;
    background: #0d0d10;
  }
  .efe-hero-step__dot::after {
    content: "";
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: #d4ff3f;
    animation: efe-pulse 2.4s ease-in-out infinite;
  }
  .efe-hero-step__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .efe-hero-step__title {
    font-size: 14.5px;
    font-weight: 600;
    color: #f5f2ec;
    letter-spacing: -0.01em;
  }
  .efe-hero-step__meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    color: #8b8b93;
  }
  .efe-hero-step__check {
    margin-left: auto;
    flex: none;
    color: #d4ff3f;
    font-size: 13px;
    opacity: 0;
    animation: efe-fade-up 0.5s ease both;
  }

  .efe-hero-panel__footer {
    flex: none;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-top: clamp(18px, 2.2vw, 24px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .efe-hero-panel__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 3.6vw, 52px);
    line-height: 1;
    color: #d4ff3f;
    letter-spacing: -0.02em;
  }
  .efe-hero-panel__foot-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8b8b93;
    text-align: right;
    line-height: 1.5;
  }

  .efe-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(280px, 3fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: stretch;
  }
  @media (min-width: 861px) {
    .efe-hero-title {
      max-width: 70vw;
    }
  }
  @media (max-width: 860px) {
    .efe-hero-grid {
      grid-template-columns: 1fr;
    }
    /* En pantallas chicas el panel queda debajo del título, empuja el CTA fuera de
       la pantalla y no aporta: se oculta. Los [data-hero-corner] que tiene adentro
       dejan de medir, y initIntro los descarta por rect vacío. */
    .efe-hero-panel {
      display: none;
    }
  }
</style>
